# Settings for compose.yml. Copy to .env next to compose.yml and fill in.
# Never commit the filled-in file.

# --- Required ---------------------------------------------------------------

# The address your instance answers on, without https://. Point its DNS at this
# server before the first start: Caddy fetches a certificate for it.
LALABASE_HOST=tickets.example.org

# Generate each value once and keep it. Losing the three encryption values
# leaves stored AI keys and repository tokens unreadable, also in every backup.
# A new SECRET_KEY_BASE signs everyone out and needs one task run afterwards
# (self-hosting docs: moving or cloning a server). Store them outside this
# server too.
#   openssl rand -hex 64     (SECRET_KEY_BASE)
#   openssl rand -hex 32     (each of the three encryption values)
SECRET_KEY_BASE=
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# The database password, used by the db service and the application.
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Starts Caddy, which terminates TLS. Remove this line if a proxy of your own
# does that; it then forwards to 127.0.0.1:3000.
COMPOSE_PROFILES=tls

# --- Mail -------------------------------------------------------------------

# Without working mail nobody can sign up: registration sends a confirmation
# link. People you create in the admin area, and people you invite, need none.
# SMTP_USERNAME is also the sender address of every mail.
SMTP_ADDRESS=smtp.example.org
SMTP_PORT=587
SMTP_DOMAIN=example.org
SMTP_USERNAME=lalabase@example.org
SMTP_PASSWORD=

# --- Optional ---------------------------------------------------------------

# The release image to run. compose.yml of each release tag names its own
# version, so leave this unset and update by checking out the next tag. Set it
# to run another release with these files, for example the previous one.
# LALABASE_VERSION=

# Building the image from the checkout instead of pulling it (compose.build.yml):
# COMPOSE_FILE=compose.yml:compose.build.yml

# Trying it on your own computer without a certificate: set
#   LALABASE_HOST=localhost:3000
#   LALABASE_FORCE_SSL=false
# remove COMPOSE_PROFILES above, and open http://localhost:3000.
# LALABASE_FORCE_SSL=

# The local port of the web service (loopback only). Default 3000.
# LALABASE_PORT=3000

# Puma threads per container; also the database pool size. Default 3.
# RAILS_MAX_THREADS=3

# Log level: debug, info, warn (default), error.
# RAILS_LOG_LEVEL=warn
