# Database
DATABASE_URL=postgresql://localhost/lalabase_development

# Rails Configuration
RAILS_ENV=development
RAILS_LOG_LEVEL=info
RAILS_MAX_THREADS=1

# Active Job / Background Processing
# Set to "1" to run SolidQueue together with Puma (embedded mode)
# Note: This disables phased restarts as plugin requires preload_app!
SOLID_QUEUE_IN_PUMA=0

# Job concurrency for SolidQueue
JOB_CONCURRENCY=1

# OpenAI (optional - can be configured per organization)
OPENAI_ACCESS_TOKEN=sk-your-api-key-here
OPENAI_ORGANIZATION_ID=org-your-org-id-here

# Email Configuration
SMTP_ADDRESS=smtp.example.com
SMTP_PORT=587
SMTP_DOMAIN=example.com
SMTP_USERNAME=noreply@example.com
SMTP_PASSWORD=your-password

# Set to "1" to disable email notifications completely in development
# Useful when letter_opener or other mail delivery methods cause issues
DISABLE_EMAIL_NOTIFICATIONS=0

# Application URLs
BASE_URL=http://localhost:3000
STAGING_URL=https://staging.example.com
PRODUCTION_URL=https://production.example.com

# Security
# No shared credentials or master key are needed for development/test.
# Rails generates a per-installation secret in tmp/local_secret.txt on first boot.
# Keep that file to preserve sessions and locally encrypted data across restarts.
# Optional override: generate your own value with bin/rails secret.
# SECRET_KEY_BASE=

# Development Tools
BUNDLE_PATH=vendor/bundle
# Active Record encryption (ai_credentials, project_repositories tokens, ...)
# Optional in development/test: missing keys are derived from SECRET_KEY_BASE.
# Generate real values with: bin/rails db:encryption:init
# ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
# ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
# ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# Where the documentation program writes its catalogue files, which is where the
# in-app help reads its pages from. Unset means this instance does not carry the
# handbook: the help then links to the public documentation instead, which is
# the normal state for a self-hosted instance.
DOCS_CATALOGUE_PATH=
