# Production Environment Variables Template
# Copy this to .env on your production server and fill in the values.
# For a NEW installation, generate fresh secrets; never replace an existing
# installation's keys during an update (sessions and encrypted data need them).

# Database
DATABASE_URL=postgresql://deploy:password@localhost/lalabase_production

# Rails Configuration
RAILS_ENV=production
# The host this instance answers on, with a port if it is not 80/443.
# Allowed hosts, mail links and Action Cable follow it, and assets are served
# from it. Left unset, the instance only answers to lalabase.com.
LALABASE_HOST=app.example.com
# Optional: an asset host (CDN). Unset or empty means "serve assets yourself".
# ASSET_HOST=
# Optional: 0 or false switches TLS off, for a trial without a proxy only.
# LALABASE_FORCE_SSL=
# Required: paste the output of bin/rails secret. Never use a public placeholder.
SECRET_KEY_BASE=
# Rails credentials are optional when all secrets are supplied through ENV.
# If used, create your OWN file with bin/rails credentials:edit --environment production
# and supply its matching config/credentials/production.key via the server or ENV.
# If secret_key_base is stored there, comment out SECRET_KEY_BASE above:
# even an empty ENV value takes precedence over the value in credentials.
# RAILS_MASTER_KEY=

# Email Configuration — replace example.com with your own provider/domain
SMTP_ADDRESS=smtp.example.com
SMTP_PORT=587
SMTP_DOMAIN=example.com
SMTP_USERNAME=noreply@example.com
SMTP_PASSWORD=your-actual-email-password-here
MAILER_DEFAULT_URL_HOST=app.example.com

# Optional: Override default FROM address
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="Lalabase System"

# OpenAI (optional - can be configured per organization)
# OPENAI_ACCESS_TOKEN=sk-your-api-key-here
# OPENAI_ORGANIZATION_ID=org-your-org-id-here

# Solid Queue Settings (if running separately from Puma)
SOLID_QUEUE_IN_PUMA=0

# Job concurrency
JOB_CONCURRENCY=2

# Application URL
BASE_URL=https://app.example.com

# Active Record encryption — REQUIRED: the app refuses to boot without these.
# Generate with: bin/rails db:encryption:init  (never commit the values).
# Deliberately left EMPTY: an empty value keeps the boot abort (with its
# explaining message) intact — a placeholder string would count as "set" and
# silently encrypt production data under a value printed in a public repo.
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=
# Key rotation only (previous READ scheme): set while old ciphertext exists,
# run `bin/rails encryption:reencrypt_tokens`, verify, then REMOVE both lines.
# ACTIVE_RECORD_ENCRYPTION_PREVIOUS_PRIMARY_KEY=
# ACTIVE_RECORD_ENCRYPTION_PREVIOUS_KEY_DERIVATION_SALT=

# Where the documentation program writes its catalogue files, which is where the
# in-app help reads its pages from. Unset means this instance does not carry the
# handbook: the help then links to the public documentation instead, which is
# the normal state for a self-hosted instance.
DOCS_CATALOGUE_PATH=
