<div class="<%= row_classes %>"
     data-inbox-bulk-select-target="row"
     data-notification-id="<%= notification.id %>">
  <%# The gutter holds the unread dot and, in the same place, the bulk
      checkbox: the checkbox shows on hover and while rows are selected
      (inbox block of application.tailwind.css), the dot otherwise. A label,
      so that a click or a tap beside the small box counts as well. Above the
      organisations the checkbox names its organisation: the bulk bar asks
      before an action on rows of more than one (inbox_bulk_select_controller). %>
  <label class="inbox-row__gutter">
    <% if unread? %>
      <%= render Neo::UnreadMarkerComponent.new(count: 1, variant: :dot, class: 'inbox-row__dot',
                                                label: t('views.organisations.notifications.item.unread_label')) %>
    <% end %>
    <%= tag.input type: 'checkbox', class: 'inbox-row__check',
                  aria: { label: t('views.organisations.notifications.item.select_aria', title: notifiable_title.presence || event_label) },
                  data: { inbox_bulk_select_target: 'checkbox', notification_id: notification.id,
                          action: 'change->inbox-bulk-select#toggle click->inbox-bulk-select#stopRowClick',
                          **organisation_data } %>
  </label>

  <%# Clickable main area: for ticket notifications the lane loads by
      turbo-frame, otherwise a full navigation. The ticket comes first (what
      it is about), who did what and where stands small below it. %>
  <%= link_to link_url, class: 'inbox-row__link', data: link_data do %>
    <span class="inbox-row__line">
      <span class="inbox-row__title"><%= notifiable_title.presence || event_label %></span>
      <span class="inbox-row__time"><%= time_ago %></span>
    </span>
    <span class="inbox-row__line inbox-row__meta">
      <span class="inbox-row__meta-text"><%= meta_line %></span>
      <% if archived? %>
        <span class="inbox-row__archived"><%= t('views.organisations.notifications.item.archived_badge') %></span>
      <% elsif new_count.positive? %>
        <span class="inbox-row__new"
              title="<%= t('views.organisations.notifications.item.bundle_badge_title', count: group_count) %>">
          <%= t('views.organisations.notifications.item.new_count', count: new_count) %>
        </span>
      <% end %>
    </span>
  <% end %>

  <%# The actions on this notification without opening it: "···" in the place
      of the time, shown on hover and on focus like the checkbox in the
      gutter, always on a touch screen (no hover there). The same buttons as
      the head of the lane. A <details>, so the menu opens without JavaScript
      too; details-autoclose closes it on a click outside and on Escape.
      Above the organisations too: the row acts in place there. %>
  <details class="more-menu inbox-row__menu" data-controller="details-autoclose">
    <summary class="more-menu__trigger" title="<%= menu_label %>" aria-label="<%= menu_label %>"><i class="bi bi-three-dots" aria-hidden="true"></i></summary>
    <div class="more-menu__items">
      <%= render 'organisations/notifications/notification_actions', notification: notification, query: @query_context.presence %>
    </div>
  </details>
</div>
