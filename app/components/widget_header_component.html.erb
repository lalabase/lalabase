<div class="flex items-center justify-between gap-2 mb-3">
  <h2 class="font-mono text-[11px] leading-4 font-semibold uppercase tracking-[0.14em] text-cream-900 min-w-0 truncate">
    <%= title %><% if subtitle.present? %><span class="font-normal normal-case tracking-normal text-cream-600"> · <%= subtitle %></span><% end %>
  </h2>
  <% if actions? %>
    <div class="flex items-center gap-2 shrink-0"><%= actions %></div>
  <% end %>
</div>
