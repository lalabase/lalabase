<% content_for :title, t('account_deletion.title') %>

<%# The account's third tab. Opening it deletes nothing: it says what deleting means,
    points to the data export first, and carries the one action, behind the current
    password and a confirmation (on the form, so Turbo asks before it submits).
    The way out is the tab row; the "Abbrechen" that led to the start page went with
    the old standalone card. The delete button is the irreversible red edge (F3,
    Neo variant danger_zone), the only red on the page. %>
<% field_class = 'block w-full rounded border border-cream-300 bg-surface-raised px-3 py-2 text-sm text-body focus:outline-none focus:border-ink focus:ring-1 focus:ring-ink transition-all' %>
<% label_class = 'mb-1 block text-sm font-medium text-cream-700' %>
<% hint_class = 'mt-1 block text-xs text-muted' %>
<div>
  <%= render 'devise/registrations/account_head', active: :delete %>

  <div class="width-capped space-y-6">
    <section aria-labelledby="account-deletion-consequences">
      <h2 id="account-deletion-consequences" class="text-sm font-semibold text-heading"><%= t('account_deletion.before_proceeding') %></h2>
      <p class="mt-1 text-sm text-body"><%= t('account_deletion.warning_message') %></p>
      <ul class="mt-3 list-disc space-y-1 ps-5 text-sm text-body">
        <li><%= t('account_deletion.consequence_data_deleted') %></li>
        <li><%= t('account_deletion.consequence_removed_from_orgs') %></li>
        <li><%= t('account_deletion.consequence_posts_anonymized') %></li>
        <li><%= t('account_deletion.consequence_irreversible') %></li>
      </ul>
    </section>

    <%# Export-before-delete hint (D3): with grace period 0 there is no window
        after confirming, this is the user's last chance to pull their data. %>
    <p class="rounded-lg border border-cream-300 bg-surface px-4 py-3 text-sm text-body">
      <i class="bi bi-download mr-1 text-cream-600" aria-hidden="true"></i>
      <%= t('account_deletion.export_hint') %>
      <%= link_to t('account_deletion.export_link'), user_data_export_path, class: 'text-info hover:underline' %>
    </p>

    <%= form_with url: account_deletion_path, method: :post, local: true, class: 'space-y-5',
                  data: { turbo_confirm: t('account_deletion.confirm_message') } do |form| %>
      <div>
        <%= form.label :reason, t('account_deletion.reason_label'), class: label_class %>
        <%= form.text_area :reason, placeholder: t('account_deletion.reason_placeholder'), rows: 4, maxlength: 500, class: field_class %>
        <small class="<%= hint_class %>"><%= t('account_deletion.max_characters') %></small>
      </div>

      <div>
        <%= form.label :current_password, t('account_deletion.password_label'), class: label_class %>
        <%= form.password_field :current_password, required: true, autocomplete: 'current-password', class: field_class %>
        <small class="<%= hint_class %>"><%= t('account_deletion.password_help') %></small>
      </div>

      <div class="flex justify-end pt-2">
        <%= render Neo::Buttons::ButtonComponent.new(variant: :danger_zone, size: :large, icon: 'trash3', tag: :button, type: 'submit') do %>
          <%= t('account_deletion.submit_button') %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
