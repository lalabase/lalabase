<%# locals: (pagy:, url: nil) %>
<%# The pagination bar of the admin area: back, "page x of y", forward. Nothing
    when the list fits on one page.

    url: a lambda from a page number to its address, for a list whose links
    carry a value the controller checked rather than what the request sent (the
    deletion register's organisation). Without it the link is this request's
    address with another page (PaginationHelper#page_url_for), filters included. %>
<% address = url || ->(page) { page_url_for(page) } %>
<% link_class = 'px-3 py-2 border-2 border-black rounded-lg text-sm font-medium hover:bg-gray-100' %>
<% if pagy.pages > 1 %>
  <nav class="flex items-center gap-3" aria-label="<%= t('admin.common.pagination.label') %>">
    <% if pagy.prev %>
      <%= link_to t('admin.common.pagination.previous'), address.call(pagy.prev), class: link_class, rel: 'prev' %>
    <% end %>
    <span class="text-sm text-gray-600"><%= t('admin.common.pagination.page_of', page: pagy.page, total: pagy.pages) %></span>
    <% if pagy.next %>
      <%= link_to t('admin.common.pagination.next'), address.call(pagy.next), class: link_class, rel: 'next' %>
    <% end %>
  </nav>
<% end %>
