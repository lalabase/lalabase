<%# locals: (stamp:) %>
<%# The stamp the list on the page was drawn with (Notifications::InboxQuery.stamp).
    Redrawn with the list, never with the counts alone: the counts can be newer
    than the list, and then the banner stays. %>
<div id="all_inboxes_drawn_stamp" hidden
     data-all-inboxes-live-target="drawn" data-stamp="<%= stamp %>"></div>
