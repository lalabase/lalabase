<%# locals: (notice: nil, alert: nil) %>
<%# What the bulk bar of the inbox above the organisations says after an action,
    in the flash of the page (layouts/_flash, the container every page has). %>
<%= turbo_stream.update 'flash' do %>
  <%= render NeoFlashContainerComponent.new(flash: { notice: notice, alert: alert }.compact) %>
<% end %>
