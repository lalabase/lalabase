<%# locals: (card:, editing: false, show_sources: false) %>
<%# The head of an open card. "Bearbeiten": for a person of several
    organisations it names the organisations at every value, and with them
    the pencils (a state of this card, taken back by "Fertig"); for a person
    of one organisation it is the pencil itself, the way into that form.
    Offered only where the reader may write somewhere. "Quellen zeigen" is the
    reader's own switch (AllPeopleController#sources): a button that sends its
    new state and the open card, answered by this card again. The ✕ closes the
    lane in place (layout-toggle). Links and the switch stay in the lane's
    frame; what leaves the page says so (_top).

    Behind "···", the rarer actions: taking a contact over into another
    organisation (per source that is a contact without an account, when there
    is somewhere to take it; the dialog of that organisation's people page,
    loaded into its frame below the head), and undoing the reader's merge: one
    source of three or more can leave alone, or the whole merge goes
    (AllPeople::MergesController#destroy, back to this card). After one source
    left, "this card" is the card of the people who stay merged: the way back
    names a source that stays, not the one that leaves. A person the same
    account alone joins has nothing stored to undo. %>
<% several = card.sources.many? %>
<% only = card.sources.first unless several %>
<% return_state = all_people_list_state.merge(AllPeopleController::CARD_PARAM => card.address) %>
<% items = [] %>
<% card.sources.select(&:takeover).each do |source| %>
  <% text = several ? t('views.all_people.card.takeover_from', organisation: source.organisation_name) : t('views.organisations.people.takeover.menu') %>
  <% items << link_to(text, new_organisation_person_takeover_path(source.organisation_id, source.takeover),
                      data: { turbo_frame: person_takeover_modal_id(source.takeover), card_takeover: true }) %>
<% end %>
<% if card.merge_id %>
  <% card.sources.select(&:detachable).each do |source| %>
    <% stays = card.sources.find { |other| !other.equal?(source) } %>
    <% back = return_state.merge(AllPeopleController::CARD_PARAM => [stays.organisation_id, stays.address].join(People::MergedCard::SEPARATOR)) %>
    <% items << button_to(t('views.all_people.card.detach', organisation: source.organisation_name),
                          all_people_merge_path(card.merge_id, back.merge(source: [source.organisation_id, source.address].join(People::MergedCard::SEPARATOR))),
                          method: :delete,
                          form: { data: { turbo_frame: '_top', card_detach: true,
                                          turbo_confirm: t('views.all_people.card.detach_confirm', name: source.name, organisation: source.organisation_name) } }) %>
  <% end %>
  <% items << button_to(t('views.all_people.merge.split'), all_people_merge_path(card.merge_id, return_state), method: :delete,
                        form: { data: { turbo_frame: '_top', card_split: true,
                                        turbo_confirm: t('views.confirm.split_merged_person', name: card.name) } }) %>
<% end %>
<div class="people-lane__head" data-lane-head data-lane-index-url="<%= all_people_path %>">
  <% if only&.edit %>
    <%= link_to all_people_edit_path(only.organisation_id, only.edit), class: 'people-ghost-action',
                                                                    data: { turbo_frame: '_top', card_edit: true } do %>
      <i class="bi bi-pencil" aria-hidden="true"></i><%= t('views.organisations.people.show.edit') %>
    <% end %>
  <% elsif several && editing %>
    <%= link_to all_people_card_path(card), class: 'people-ghost-action', data: { card_edit_done: true } do %>
      <i class="bi bi-check-lg" aria-hidden="true"></i><%= t('views.all_people.card.edit_done') %>
    <% end %>
  <% elsif several && card.sources.any?(&:can_edit) %>
    <%= link_to all_people_card_path(card, editing: true), class: 'people-ghost-action', data: { card_edit: true } do %>
      <i class="bi bi-pencil" aria-hidden="true"></i><%= t('views.organisations.people.show.edit') %>
    <% end %>
  <% end %>
  <% if several %>
    <%= button_to all_people_sources_path, method: :patch,
                  params: { show: (show_sources ? '0' : '1'), AllPeopleController::CARD_PARAM => card.address,
                            AllPeopleController::EDITING_PARAM => ('1' if editing) }.compact,
                  class: 'people-ghost-action all-people-card__switch', 'aria-pressed': show_sources.to_s,
                  form: { data: { card_sources_switch: true } } do %>
      <i class="bi bi-building" aria-hidden="true"></i><%= t('views.all_people.card.show_sources') %>
    <% end %>
  <% end %>
  <% if items.any? %>
    <%# The id the takeover dialog returns the focus to: the trigger of this menu, named
        by the first contact it offers (person_more_actions_id). %>
    <% first_takeover = card.sources.filter_map(&:takeover).first %>
    <details class="more-menu" data-controller="details-autoclose">
      <summary class="more-menu__trigger" <%= tag.attributes(id: (person_more_actions_id(first_takeover) if first_takeover)) %>
               title="<%= t('views.all_people.card.more_actions') %>"
               aria-label="<%= t('views.all_people.card.more_actions') %>"><i class="bi bi-three-dots" aria-hidden="true"></i></summary>
      <div class="more-menu__items"><%= safe_join(items) %></div>
    </details>
  <% end %>
  <span class="people-lane__divider" aria-hidden="true"></span>
  <button type="button" class="people-icon-action" title="<%= t('views.organisations.people.show.close') %>"
          aria-label="<%= t('views.organisations.people.show.close') %>"
          data-lane-close data-action="click->layout-toggle#closeContent">
    <i class="bi bi-x-lg" aria-hidden="true"></i>
  </button>
</div>
<%# contents: an empty frame takes no gap of the column; the dialog is fixed. %>
<% card.sources.filter_map(&:takeover).each do |person_id| %>
  <%= turbo_frame_tag person_takeover_modal_id(person_id), class: 'contents' %>
<% end %>
