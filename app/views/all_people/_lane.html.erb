<%# locals: (card: nil, missing: false) %>
<%# What the lane frame holds: the card of a person (People::MergedCard), the
    one answer for an address that names nobody the reader can see (missing),
    or nothing yet. Rendered by the page on a full visit and alone for a
    request of the frame. all-people-card marks LOADED content for
    layout-toggle and index-page; the other two must not carry it, or they
    open an empty column. "Bearbeiten" (editing) and "Quellen zeigen" are read
    here, once for both ways in: they decide where the organisations stand. %>
<% if card %>
  <div class="all-people-card people-lane min-w-0 relative" data-all-people-card="<%= card.address %>">
    <%= render 'all_people/card', card: card,
                                  editing: params[AllPeopleController::EDITING_PARAM] == '1',
                                  show_sources: current_user.preference_store.people_card_sources? %>
  </div>
<% else %>
  <% text = missing ? 'missing' : 'placeholder' %>
  <div class="people-lane min-w-0 relative">
    <div id="all-people-card-placeholder" class="ticket-placeholder px-4 py-10 text-center" <%= 'data-all-people-missing' if missing %>>
      <h2 class="text-lg font-semibold text-heading"><%= t("views.all_people.card.#{text}_title") %></h2>
      <p class="text-sm text-muted"><%= t("views.all_people.card.#{text}_body") %></p>
    </div>
  </div>
<% end %>
