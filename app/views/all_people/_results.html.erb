<%# locals: (people:) %>
<%# The rows of the list (People::AcrossOrganisations::Result): four columns the
    reader compares, so a table at full width. The search reloads only this
    frame; every link in it leaves the frame (_top). %>
<turbo-frame id="<%= AllPeopleController::LIST_FRAME_ID %>">
  <% if people.rows.any? %>
    <table class="all-people-table">
      <thead>
        <tr>
          <th scope="col" class="column-head"><%= t('views.all_people.columns.name') %></th>
          <th scope="col" class="column-head all-people-table__wide"><%= t('views.all_people.columns.function') %></th>
          <th scope="col" class="column-head"><%= t('views.all_people.columns.organisations') %></th>
          <th scope="col" class="column-head all-people-table__wide"><%= t('views.all_people.columns.last_contact') %></th>
        </tr>
      </thead>
      <tbody>
        <% people.rows.each do |row| %>
          <%= render 'all_people/row', row: row %>
        <% end %>
      </tbody>
    </table>
    <% if people.pages > 1 %>
      <nav class="all-people-paging" aria-label="<%= t('views.all_people.paging.label') %>">
        <% if people.page > 1 %>
          <%= link_to t('views.all_people.paging.previous'), all_people_page_path(people.page - 1),
                      rel: 'prev', class: 'people-text-action', data: { turbo_frame: '_top' } %>
        <% end %>
        <span><%= t('views.all_people.paging.position', page: people.page, pages: people.pages) %></span>
        <% if people.page < people.pages %>
          <%= link_to t('views.all_people.paging.next'), all_people_page_path(people.page + 1),
                      rel: 'next', class: 'people-text-action', data: { turbo_frame: '_top' } %>
        <% end %>
      </nav>
    <% end %>
  <%# Without the right in any organisation that is what the page says, also with a
      search in the address: "nobody matches" would be the wrong reason. %>
  <% elsif people.organisations.empty? %>
    <div class="people-empty" data-all-people-empty="no-right">
      <i class="bi bi-people people-empty__icon" aria-hidden="true"></i>
      <p class="people-empty__title"><%= t('views.all_people.empty.no_right_title') %></p>
      <p class="people-empty__text width-text"><%= t('views.all_people.empty.no_right_text') %></p>
    </div>
  <% elsif all_people_list_state[:q] %>
    <div class="people-empty" data-all-people-empty="no-hits">
      <p class="people-empty__title"><%= t('views.all_people.empty.no_hits_title', query: all_people_list_state[:q]) %></p>
      <p class="people-empty__text"><%= t('views.all_people.empty.no_hits_text') %></p>
      <%= link_to t('views.all_people.empty.clear_search'), all_people_path(all_people_list_state.except(:q)),
                  class: 'people-text-action', data: { turbo_frame: '_top' } %>
    </div>
  <% else %>
    <div class="people-empty" data-all-people-empty="no-people">
      <i class="bi bi-people people-empty__icon" aria-hidden="true"></i>
      <p class="people-empty__title"><%= t('views.all_people.empty.no_people_title') %></p>
      <p class="people-empty__text width-text"><%= t('views.all_people.empty.no_people_text') %></p>
    </div>
  <% end %>
  <%# The search reloads only this frame. The count and the select stand outside
      it and carry the search, so they come along as a stream, INSIDE the frame:
      after </turbo-frame> Turbo drops it (the people page's tabs do the same). %>
  <% if turbo_frame_request_id == AllPeopleController::LIST_FRAME_ID %>
    <%= turbo_stream.replace 'all_people_tools' do %>
      <%= render 'all_people/tools', people: people %>
    <% end %>
  <% end %>
</turbo-frame>
