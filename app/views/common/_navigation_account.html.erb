<%# The sidebar's middle on an account page (no organisation): the pages of "Mein
    Konto" (common/_account_nav_list, shared with the account layer) and, for someone
    who came from an organisation, the way back to it. %>
<div class="w-full px-4 pt-6">
  <%= render 'common/account_nav_list' %>

  <% if session[:current_organisation_id].present? %>
    <% org = Organisation.find_by(id: session[:current_organisation_id]) %>
    <% if org %>
      <p class="px-3 pb-1.5 pt-5 font-mono text-[11px] font-semibold uppercase tracking-[0.14em] text-muted"><%= t('navigation.organisation') %></p>
      <ul class="flex flex-col gap-1">
        <%= render 'common/navigation_item',
              name: t('navigation.back_to_organisation'),
              path: organisation_projects_path(organisation_id: org.id),
              icon: 'bi bi-arrow-left' %>
      </ul>
    <% end %>
  <% end %>
</div>
