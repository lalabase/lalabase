<div class="w-full px-4 pt-6">
  <div class="mb-2">
    <div class="flex items-start justify-between px-2 mb-3">
      <h3 class="text-xs font-bold uppercase text-cream-600">
        <%= t('navigation.account_section') %>
      </h3>
    </div>

    <ul class="flex flex-col gap-2">
      <%# "Alle Organisationen" (not "wechseln"): from the account section you are not in an
          org context, so the label matches the org switcher menu's cockpit link. %>
      <%= render 'common/navigation_item',
        name: t('navigation.all_organisations'),
        path: select_organisation_path,
        icon: 'bi bi-building',
        hover_color: '#f5f1ea',
        active: request.path == select_organisation_path %>

      <%= render 'common/navigation_item',
        name: t('navigation.profile'),
        path: edit_user_registration_path,
        icon: 'bi bi-person-fill',
        hover_color: '#f5f1ea',
        active: [edit_user_registration_path, edit_user_registration_password_path, new_account_deletion_path, user_registration_display_path].include?(request.path) %>

      <%# Billing accounts (K1 revised): the area hangs on the account, not on an
          organisation, and this navigation is the only one that renders without a tenant
          (see layouts/application.html.erb). That way an account owner WITHOUT any
          membership anywhere reaches it too -- that is N1, and the reason the area was
          pulled out of the organisation at all.

          Always visible, not only for people with an account: checking visibility would
          cost one round of Subscriptions::VisibleAccounts on EVERY page of this area
          (one role query per organisation of the user). Whoever has none sees the
          honest empty state, just like with the data export. %>
      <%= render 'common/navigation_item',
        name: t('navigation.billing_accounts'),
        path: billing_accounts_path,
        icon: 'bi bi-receipt',
        hover_color: '#f5f1ea',
        active: request.path.start_with?('/billing') %>

      <%= render 'common/navigation_item',
        name: t('navigation.data_export'),
        path: user_data_export_path,
        icon: 'bi bi-download',
        hover_color: '#f5f1ea',
        active: request.path.start_with?('/user_data_export') %>

      <%# API tokens and preferences are entries of their own since 2026-11-12. Until
          then both hung under a "Präferenzen" group with seven sub-pages. The tokens
          are a function (a list, a create flow), not a setting of how the application
          behaves; the preferences are one page of sections (user_preferences/edit). %>
      <%= render 'common/navigation_item',
        name: t('navigation.settings_api_tokens'),
        path: users_personal_access_tokens_path,
        icon: 'bi bi-key',
        hover_color: '#f5f1ea',
        active: request.path.start_with?('/users/personal_access_tokens') %>

      <%= render 'common/navigation_item',
        name: t('navigation.preferences'),
        path: edit_user_preferences_path,
        icon: 'bi bi-person-gear',
        hover_color: '#f5f1ea',
        active: request.path.start_with?('/user_preferences') %>

    </ul>

    <% if session[:current_organisation_id].present? %>
      <div class="mt-6 mb-2">
        <div class="px-2 mb-3">
          <h3 class="text-xs font-bold uppercase text-cream-600">
            <%= t('navigation.organisation') %>
          </h3>
        </div>
        <ul class="flex flex-col gap-2">
          <% org = Organisation.find_by(id: session[:current_organisation_id]) %>
          <% if org %>
            <%= render 'common/navigation_item',
              name: t('navigation.back_to_organisation'),
              path: organisation_projects_path(organisation_id: org.id),
              icon: 'bi bi-arrow-left',
              hover_color: '#f5f1ea' %>
          <% end %>
        </ul>
      </div>
    <% end %>
  </div>
</div>
