<%# locals: (organisations:) %>
<%# The sidebar's middle on the inbox above the organisations (user, 2026-11-12):
    the level above the organisations instead of the pages of "Mein Konto". The
    inbox itself, the cockpit beside it, then every organisation of the list with
    its unread count. An organisation narrows the list to itself; the open one is
    marked, and "Gesamt-Inbox" is the way back to all of them. Rows are the
    sidebar's own (common/_navigation_item). organisations: the counts of
    Notifications::InboxQuery ([{ id:, name:, unread: }]), the numbers the cockpit
    tiles show. The id is the target of the stream that redraws the counts after
    a row action (all_inboxes/update). %>
<% chosen = params[InboxHelper::INBOX_ORGANISATION_PARAM].presence %>
<div id="all_inboxes_nav" class="w-full px-4 pt-6" data-all-inboxes-nav>
  <ul class="flex flex-col gap-1">
    <%= render 'common/navigation_item', name: t('navigation.all_inboxes'), path: all_inboxes_path,
                                         icon: 'bi bi-bell', active: chosen.nil?,
                                         aria_current: ('page' if chosen.nil?) %>
    <%= render 'common/navigation_item', name: t('navigation.all_organisations'), path: select_organisation_path,
                                         icon: 'bi bi-grid' %>
  </ul>

  <p class="px-3 pb-1.5 pt-5 font-mono text-[11px] font-semibold uppercase tracking-[0.14em] text-muted"><%= t('navigation.organisations') %></p>
  <nav aria-label="<%= t('navigation.organisations') %>">
    <ul class="flex flex-col gap-1">
      <% organisations.each do |organisation| %>
        <%= render 'common/navigation_item',
              name: organisation[:name],
              path: all_inboxes_path(InboxHelper::INBOX_ORGANISATION_PARAM => organisation[:id]),
              icon: 'bi bi-building', active: chosen == organisation[:id],
              aria_current: ('true' if chosen == organisation[:id]),
              count: organisation[:unread] %>
      <% end %>
    </ul>
  </nav>
</div>
