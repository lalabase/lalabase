<!-- Compact User Menu for Sidebar -->
<% if current_organisation.blank? %>
  <!-- Account context: simplified menu (profile/settings are already in main nav) -->
  <div class="flex items-center gap-3 py-2 px-4">
    <i class="bi bi-person-fill"></i>
    <span class="flex-1 truncate">
      <%= current_user.email.split('@').first if current_user %>
    </span>
    <%= link_to destroy_user_session_path, class: 'flex items-center gap-1 text-sm hover:text-red-600 transition-colors', title: t('navigation.logout'), data: { turbo_method: :delete } do %>
      <i class="bi bi-box-arrow-right text-xs"></i>
      <%= t('navigation.logout') %>
    <% end %>
  </div>
<% else %>
  <%# Organisation context: the name is the handle of the account layer
      (common/_account_layer, F47). A click raises the pages of "Mein Konto" over the
      sidebar and leaves the page alone. It is a link to the account page, which is
      what it does without JavaScript; sidebar_layer_controller makes it a button
      (role, aria-expanded) and keeps the click. Until 2026-11-12 it was a <details>
      with a short menu of its own. The chevron is F22: it turns while the layer is
      open (components/sidebar_layer.css reads aria-expanded). %>
  <% account_name = current_user.email.split('@').first %>
  <%= link_to edit_user_registration_path,
        class: 'sidebar-layer__trigger flex items-center gap-3 rounded px-4 py-2 transition-colors hover:bg-cream-200',
        aria: { label: "#{t('navigation.account_section')}: #{account_name}", controls: 'account-layer' },
        data: { sidebar_layer_target: 'trigger', action: 'click->sidebar-layer#toggle' } do %>
    <span class="relative inline-flex">
      <i class="bi bi-person-fill" aria-hidden="true"></i>
      <%# Quiet unread marker for platform news (lime, not the red notification colour). %>
      <% if changelog_in_navigation? && changelog_has_unread?(current_user) %>
        <span class="changelog-unread-dot absolute -top-1 -end-1 w-2 h-2 bg-lime-500 rounded-full border border-stroke"></span>
      <% end %>
    </span>
    <span class="flex-1 truncate"><%= account_name %></span>
    <i class="bi bi-chevron-down sidebar-layer__chevron text-[10px] text-muted" aria-hidden="true"></i>
  <% end %>
<% end %>
