<%# locals: (active:) %>
<%# The head of the account page: the title, the help on the right and the three tabs
    (profile, password, delete account). Each tab is a page of its own, as every tab
    row in the application is: a link one can keep, and "back" works. The delete tab
    opens the page that explains what deleting means; the action is there, behind a
    password and a confirmation, never on the tab.

    Rendered by devise/registrations/edit, edit_password and account_deletions/new.
    The account area has no organisation, so this is the shared head
    (organisations/shared/_subnav) without the management area's own wrapper. %>
<% head_tools = capture do %>
  <%= render 'common/contextual_help_menu', context: :account %>
<% end %>
<%= render 'organisations/shared/subnav',
      title: t('views.devise.registrations.edit.title'),
      aria_label: t('views.devise.registrations.tabs.aria_label'),
      active: active,
      right_content: head_tools,
      tabs: [
        { key: :profile, label: t('views.devise.registrations.tabs.profile'), path: edit_user_registration_path },
        { key: :password, label: t('views.devise.registrations.tabs.password'), path: edit_user_registration_password_path },
        { key: :delete, label: t('views.devise.registrations.tabs.delete'), path: new_account_deletion_path }
      ] %>
