<%# The account's first tab: name and address. The password and deleting the account
    are tabs of their own (devise/registrations/_account_head). Fields in the style of
    the other forms of the application, one value per row, capped (.width-capped). %>
<% field_class = 'block w-full rounded border border-cream-300 bg-surface-raised px-3 py-2 text-sm text-body focus:outline-none focus:border-ink focus:ring-1 focus:ring-ink transition-all' %>
<% label_class = 'mb-1 block text-sm font-medium text-cream-700' %>
<% hint_class = 'mt-1 block text-xs text-muted' %>
<div>
  <%= render 'devise/registrations/account_head', active: :profile %>

  <div class="width-capped">
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: 'space-y-5', data: { turbo: false } }) do |f| %>
      <%= render 'devise/shared/error_messages', resource: resource %>

      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div>
          <%= f.label :first_name, t('views.devise.registrations.edit.first_name'), class: label_class %>
          <%= f.text_field :first_name, autocomplete: 'given-name', class: field_class %>
        </div>
        <div>
          <%= f.label :last_name, t('views.devise.registrations.edit.last_name'), class: label_class %>
          <%= f.text_field :last_name, autocomplete: 'family-name', class: field_class %>
        </div>
      </div>

      <%# The profile picture lives in the preferences' profile section
          (user_preferences/edit): this Devise form demands the current
          password for every change - unreasonable for a picture (04.09.2026). %>

      <div>
        <%= f.label :email, class: label_class %>
        <%= f.email_field :email, autocomplete: 'email', class: field_class %>
        <%# Said BEFORE the change, not only after (the pending note below): with
            reconfirmable the address does not switch on save, which reads as a bug
            if nobody announced it. %>
        <% if devise_mapping.confirmable? %>
          <small class="<%= hint_class %>"><%= t('views.devise.registrations.edit.email_change_hint') %></small>
        <% end %>
        <%# Devise re-renders an unsaved resource after a rejected update.
            The hint must describe the saved user, not the submitted address. %>
        <small class="<%= hint_class %> break-words" data-shown-email-hint>
          <%= t("views.devise.registrations.edit.shown_email.#{current_user.email_visibility}", email: current_user.shown_email) %>
          <%= link_to t('views.devise.registrations.edit.shown_email.change'), preferences_section_path('display'), class: 'underline' %>
        </small>
      </div>

      <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
        <p class="rounded-lg border border-cream-300 bg-surface px-4 py-3 text-sm text-body">
          <%= t('views.devise.registrations.edit.pending_confirmation', email: resource.unconfirmed_email) %>
        </p>
      <% end %>

      <div>
        <%= f.label :current_password, t('views.devise.registrations.edit.current_password'), class: label_class %>
        <%= f.password_field :current_password, autocomplete: 'current-password', class: field_class %>
        <small class="<%= hint_class %>"><%= t('views.devise.registrations.edit.current_password_hint') %></small>
      </div>

      <div class="flex justify-end pt-2">
        <%= render Neo::Buttons::ButtonComponent.new(variant: :primary, size: :large, tag: :button, type: 'submit') do %>
          <%= t('views.devise.registrations.edit.save_profile') %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
