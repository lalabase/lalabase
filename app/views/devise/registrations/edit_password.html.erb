<%# The account's password tab. The form PUTs to Devise's registration like the
    profile form; account_tab tells Users::RegistrationsController#respond_with to
    bring a refused change back here instead of to the profile tab.

    Plain fields of the application, not devise/shared/_password_field: that partial
    is drawn by auth.css, which only the pages without a session load. The minimum
    length is read from Devise, never typed into the text. %>
<% field_class = 'block w-full rounded border border-cream-300 bg-surface-raised px-3 py-2 text-sm text-body focus:outline-none focus:border-ink focus:ring-1 focus:ring-ink transition-all' %>
<% label_class = 'mb-1 block text-sm font-medium text-cream-700' %>
<% hint_class = 'mt-1 block text-xs text-muted' %>
<div>
  <%= render 'devise/registrations/account_head', active: :password %>

  <div class="width-capped">
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: 'space-y-5', data: { turbo: false } }) do |f| %>
      <%= hidden_field_tag :account_tab, Users::RegistrationsController::PASSWORD_TAB %>
      <%= render 'devise/shared/error_messages', resource: resource %>

      <div>
        <%= f.label :password, t('views.devise.registrations.edit.new_password'), class: label_class %>
        <%= f.password_field :password, autocomplete: 'new-password', class: field_class %>
        <small class="<%= hint_class %>">
          <%= t('views.devise.registrations.edit.password_min_length', count: @minimum_password_length || Devise.password_length.min) %>
        </small>
      </div>

      <div>
        <%= f.label :password_confirmation, t('views.devise.registrations.edit.confirm_new_password'), class: label_class %>
        <%= f.password_field :password_confirmation, autocomplete: 'new-password', class: field_class %>
      </div>

      <div>
        <%= f.label :current_password, t('views.devise.registrations.edit.current_password'), class: label_class %>
        <%= f.password_field :current_password, autocomplete: 'current-password', class: field_class %>
        <small class="<%= hint_class %>"><%= t('views.devise.registrations.edit.current_password_hint') %></small>
      </div>

      <div class="flex justify-end pt-2">
        <%= render Neo::Buttons::ButtonComponent.new(variant: :primary, size: :large, tag: :button, type: 'submit') do %>
          <%= t('views.devise.registrations.edit.save_password') %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
