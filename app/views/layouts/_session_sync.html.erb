<%# Synchronize user preferences between server and client %>
<% items_value = current_user&.respond_to?(:items_per_page_preference) ? current_user.items_per_page_preference : nil %>
<script>
  (function() {
    // Synchronisiere items_per_page Wert aus User-Preference
    const serverItemsPerPage = <%= items_value.to_json %>;

    if (serverItemsPerPage) {
      sessionStorage.setItem('items_per_page', serverItemsPerPage);
    }
  })();
</script>
