<%# locals: (id:, refresh_action: nil, shown: true) %>
<%# "New notifications have arrived" above an inbox list, for both inboxes. A part
    of the page that stays (Belegungstabelle F30: tinted, edge, no shadow) with
    one word that acts here (F4).

    - The inbox of an organisation: Notifications::BroadcastService replaces the
      empty #new_notifications_banner with it when a notification arrives; the
      word loads the page again.
    - The inbox above the organisations: drawn hidden with the page,
      all_inboxes_live_controller shows it and redraws the list on the word
      (refresh_action). %>
<%= tag.div id: id, role: 'status',
            class: [('hidden' unless shown), 'mb-3 flex items-center justify-between gap-3 rounded-lg border border-edge bg-surface-shell px-3 py-2 text-sm text-body'],
            data: (refresh_action ? { all_inboxes_live_target: 'banner' } : {}) do %>
  <span><%= t('views.organisations.notifications.new_banner.text') %></span>
  <% word_classes = 'text-sm font-medium text-body underline underline-offset-2 hover:text-heading focus:outline-none focus-visible:ring-1 focus-visible:ring-ink rounded' %>
  <% if refresh_action %>
    <button type="button" class="<%= word_classes %>" data-action="<%= refresh_action %>">
      <%= t('views.organisations.notifications.new_banner.refresh') %>
    </button>
  <% else %>
    <%# An empty address is this page: Turbo visits it again, the whole page. %>
    <a href="" class="<%= word_classes %>" data-turbo-frame="_top" data-turbo-action="replace">
      <%= t('views.organisations.notifications.new_banner.refresh') %>
    </a>
  <% end %>
<% end %>
