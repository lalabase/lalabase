<%# The line under the cockpit's heading, in both layouts (stacked and rows): the
    subtitle and, for a person with several organisations, the way to every
    notification of all of them, the inbox above the organisations (a link to
    another place, Belegungstabelle F5). The rows of the roll-up keep leading
    into their organisation. %>
<div class="mb-6 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
  <p class="text-cream-600"><%= t('views.organisations.select.cockpit.subtitle') %></p>
  <% if switcher_organisations(current_user).many? %>
    <%= link_to t('views.organisations.select.cockpit.all_inboxes'), all_inboxes_path,
                class: 'text-sm font-medium text-info hover:underline focus:outline-none focus-visible:ring-1 focus-visible:ring-info rounded',
                data: { all_inboxes_entry: 'cockpit' } %>
  <% end %>
</div>
