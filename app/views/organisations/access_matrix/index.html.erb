<%# Org-wide access matrix (read-only): rows = active members, cols = active projects.
    The cell shows the EFFECTIVE, condensed access + provenance (see AccessCheck::OrgAccessMatrix
    and doc/zugriffs_matrix_plan.md).

    The tool row is the one every list has (F13, F35): the project pill
    (shared/filter_pill) and the list search (NeoListSearchComponent). Both live in the
    address (projects[], q) and the server answers them. Until 2026-11-12 an always open
    field and a square "Projekte" button drove a script that hid rows and cells in the
    browser; the pill did not say which projects were chosen, and nothing could be linked. %>
<% areas = ProjectPermission.access_areas %>
<div id="access-matrix">

  <%# The second tab of the members section (doc/verwaltung_seitennavigation_plan.md
      §5): the head is the section's, the way back to the list is its first tab. %>
  <%= render 'organisations/shared/settings_subnav', active: :members,
                                                     tabs: members_section_tabs(current_organisation), tab_active: :access_matrix %>

  <% if @matrix.all_projects.empty? %>
    <%= render 'shared/empty_content',
          variant: :first_time,
          icon_class: 'bi bi-diagram-3',
          title: t('views.organisations.access_matrix.empty.title'),
          description: t('views.organisations.access_matrix.empty.body'),
          cta_text: t('views.organisations.access_matrix.empty.cta'),
          cta_url: new_organisation_project_path(current_organisation) %>
  <% else %>
    <%# One row of tools. query-toggle points each option of the pill at the address the
        browser is on (a search changes it without a page visit); without JavaScript the
        links are the page-load addresses. A pill change is a page visit, a search reloads
        only the grid.
        relative z-dropdown: .filter-bar carries a backdrop-filter, which makes the row a
        stacking context of its own at level zero; without a level the pill's menu opened
        UNDER the grid's sticky head cells (z-index 1 to 3). %>
    <div class="filter-bar relative z-dropdown mb-4 flex flex-wrap items-center gap-2" data-controller="query-toggle">
      <%= render 'shared/filter_pill',
                 key: 'projects',
                 label: access_matrix_projects_label(@matrix),
                 set: @matrix.chosen_project_ids.any?,
                 options: access_matrix_project_options(@matrix, current_organisation),
                 filterable: @matrix.all_projects.size > 8,
                 clear_url: access_matrix_path_with(current_organisation, projects: []),
                 clear_owns: time_filter_owns_pairs(projects: []) %>

      <%= render NeoListSearchComponent.new(
        url: organisation_access_matrix_index_path(current_organisation), name: :q,
        value: params[:q].is_a?(String) ? params[:q] : nil,
        input_id: 'access-matrix-search', frame: 'access_matrix_grid', turbo_action: 'replace',
        form_class: 'access-matrix-search',
        label: t('views.organisations.access_matrix.filter.search_placeholder'),
        placeholder: t('views.organisations.access_matrix.filter.search_placeholder'),
        wrapper_class: 'ms-auto'
      ) do %>
        <% @matrix.chosen_project_ids.each do |id| %><%= hidden_field_tag 'projects[]', id, id: nil %><% end %>
      <% end %>
    </div>

    <%# Collapsible legend (mirrors the Team page legend pattern). %>
    <details class="am-legend mb-4 text-sm">
      <summary class="cursor-pointer text-muted hover:text-heading">
        <%= t('views.organisations.access_matrix.legend.title') %>
      </summary>
      <ul class="mt-2 space-y-1.5 text-body">
        <li class="flex items-center gap-2">
          <span class="am-pill inline-flex items-center gap-1 rounded border px-2 py-0.5 text-xs font-medium bg-emerald-100 text-emerald-800 border-emerald-300"><i class="bi bi-pencil" aria-hidden="true"></i></span>
          <%= t('views.organisations.access_matrix.legend.read_write') %>
        </li>
        <li class="flex items-center gap-2">
          <span class="am-pill inline-flex items-center gap-1 rounded border px-2 py-0.5 text-xs font-medium bg-amber-100 text-amber-800 border-amber-300"><i class="bi bi-eye" aria-hidden="true"></i></span>
          <%= t('views.organisations.access_matrix.legend.read_only') %>
        </li>
        <li class="flex items-center gap-2">
          <span class="am-pill inline-flex items-center gap-1 rounded border px-2 py-0.5 text-xs font-medium bg-red-100 text-red-800 border-red-300"><i class="bi bi-x-circle" aria-hidden="true"></i></span>
          <%= t('views.organisations.access_matrix.legend.blocked') %>
        </li>
        <li class="flex items-center gap-2">
          <span class="am-pill inline-flex items-center gap-1 rounded border px-2 py-0.5 text-xs font-medium bg-cream-100 text-cream-500 border-cream-300"><i class="bi bi-dash-lg" aria-hidden="true"></i></span>
          <%= t('views.organisations.access_matrix.legend.none') %>
        </li>
        <li class="flex items-center gap-2">
          <i class="bi bi-lock-fill text-xs" aria-hidden="true"></i>
          <%= t('views.organisations.access_matrix.legend.inherited') %>
        </li>
      </ul>
    </details>

    <%# target _top: the search aims at this frame, but a column head inside it leads to
        another page (the project's team), which must load as a whole. %>
    <%= turbo_frame_tag 'access_matrix_grid', target: '_top' do %>
    <% if @matrix.users.empty? %>
      <p class="text-sm text-muted"><%= t('views.organisations.access_matrix.filter.no_members') %></p>
    <% else %>
    <%# Sticky, horizontally scrollable grid. %>
    <div class="am-scroll overflow-x-auto">
      <table class="am-table border-collapse text-sm">
        <thead>
          <tr>
            <th scope="col" class="am-corner" data-matrix-head>
              <%= t('views.organisations.access_matrix.index.member_header') %>
            </th>
            <% @matrix.projects.each do |project| %>
              <th scope="col" class="am-colhead" data-matrix-head
                  data-project-id="<%= project.id %>">
                <%= link_to organisation_project_project_permissions_path(current_organisation, project),
                      class: "am-colhead__link",
                      title: t('views.organisations.access_matrix.index.column_link_title', project: project.name) do %>
                  <%= project.name %>
                <% end %>
              </th>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <% @matrix.users.each do |user| %>
            <tr>
              <th scope="row" class="am-rowhead"><%= viewer_display_name(user) %></th>
              <% @matrix.projects.each do |project| %>
                <td class="am-cell-td"
                    data-project-id="<%= project.id %>">
                  <%= render Organisations::AccessMatrix::SummaryCellComponent.new(
                        cell: @matrix.cell(user, project), areas: areas
                      ) %>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <p class="mt-2 text-xs text-muted md:hidden">
      <%= t('views.organisations.access_matrix.index.wide_screen_hint') %>
    </p>
    <% end %>
    <% end %>
  <% end %>
</div>
