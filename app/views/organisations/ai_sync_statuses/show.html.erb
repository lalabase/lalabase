<div>
  <%# The head of the section with its tab row, "Indexierung" open, the help right of the
      title (doc/verwaltung_seitennavigation_plan.md §4, S3); the row that held it is gone. %>
  <% head_tools = capture do %>
    <%= render 'common/contextual_help_menu', context: :settings_ai_sync %>
  <% end %>
  <%= render 'organisations/shared/settings_subnav', active: :ai, tabs: ai_section_tabs(@current_organisation), tab_active: :index,
                                                     right_content: head_tools %>

  <%# The shapes of the surface table, like the other tabs of the section: a section is a
      quiet heading over its content (no card with a head of its own), counts stand in
      mono (F26), lists are tables with the column head (F43). Colour says a state only
      where there is one: a failure count above zero is red, nothing else is tinted.
      Until 2026-11-12 the page drew coloured tiles, rings and one colour per content
      type, and the colours meant nothing a reader could name.

      No top margin: the tab bar holds the distance to the content (its mb-3.5), the
      same on every tab of the section. %>
  <div class="space-y-10">

  <%# The answer first, the raw numbers after (§3.5 of doc/ki_bereich_navigation_plan.md). %>
  <%= render 'organisations/ai_sync_statuses/summary' %>

  <% overview = @sync_statistics[:overview] %>
  <section aria-labelledby="ai-sync-overview">
    <h2 id="ai-sync-overview" class="mb-3 text-sm font-semibold text-heading">
      <%= t('views.organisations.ai_sync_statuses.show.overview') %>
    </h2>
    <%# One row of figures, cells parted by a hairline (gap-px over the divider tone). %>
    <dl class="grid grid-cols-2 gap-px overflow-hidden rounded-lg border border-cream-300 bg-cream-200 md:grid-cols-3 xl:grid-cols-6">
      <% [[:total_content, overview[:total_content]],
          [:with_embeddings, overview[:with_embeddings]],
          [:pending, overview[:pending_embeddings]],
          [:errors, overview[:embedding_errors]],
          [:total_fragments, overview[:total_fragments]],
          [:fragments_with_embeddings, overview[:fragments_with_embeddings]]].each do |key, value| %>
        <div class="bg-surface-raised px-4 py-3" data-overview-figure="<%= key %>">
          <dt class="text-xs text-muted"><%= t("views.organisations.ai_sync_statuses.show.#{key}") %></dt>
          <dd class="mt-1 font-mono text-lg tabular-nums <%= key == :errors && value.to_i.positive? ? 'text-red-700' : 'text-heading' %>">
            <%= number_with_delimiter(value) %>
          </dd>
        </div>
      <% end %>
    </dl>
  </section>

  <section aria-labelledby="ai-sync-projects">
    <h2 id="ai-sync-projects" class="mb-3 text-sm font-semibold text-heading">
      <%= t('views.organisations.ai_sync_statuses.show.projects') %>
    </h2>
    <% if @sync_statistics[:projects].any? %>
      <table class="min-w-full border-collapse">
        <thead>
          <tr>
            <% [[:col_project, 'text-start'], [:processed, 'text-start'], [:pending, 'text-end'], [:errors, 'text-end']].each do |key, align| %>
              <th scope="col" class="column-head border-b border-ink px-4 py-3 first:ps-0 <%= align %>">
                <%= t("views.organisations.ai_sync_statuses.show.#{key}") %>
              </th>
            <% end %>
            <th scope="col" class="column-head w-10 border-b border-ink pe-0"><span class="sr-only"><%= t('views.organisations.ai_sync_statuses.show.col_details') %></span></th>
          </tr>
        </thead>
        <% @sync_statistics[:projects].each do |project_stats| %>
          <% totals = project_stats[:totals] %>
          <% enabled = totals[:embeddings_enabled] %>
          <% processed = totals[:embeddings_processed] %>
          <% percentage = enabled.positive? ? (processed.to_f / enabled * 100).round : 0 %>
          <%# One tbody per project: the row opens the detail row below it. The click
              is on the row, the button in the last cell gives the keyboard a way in
              (its click bubbles to the row, so it toggles once). %>
          <tbody class="border-b border-cream-200" data-controller="toggle">
            <tr class="cursor-pointer hover:bg-cream-100" data-action="click->toggle#toggle">
              <td class="px-4 py-3 ps-0">
                <div class="text-sm font-medium text-heading"><%= project_stats[:project].name %></div>
                <div class="text-xs text-muted" data-project-content-count>
                  <%= t('views.organisations.ai_sync_statuses.show.content_count', count: totals[:total]) %>
                </div>
              </td>
              <td class="px-4 py-3">
                <div class="flex items-center gap-3">
                  <span class="font-mono text-[13px] tabular-nums text-body whitespace-nowrap"><%= number_with_delimiter(processed) %>/<%= number_with_delimiter(enabled) %></span>
                  <span class="h-1.5 w-24 shrink-0 overflow-hidden rounded-full bg-cream-200" aria-hidden="true">
                    <span class="block h-full bg-cream-700" style="width: <%= percentage %>%"></span>
                  </span>
                  <span class="font-mono text-[13px] tabular-nums text-muted"><%= percentage %>%</span>
                </div>
              </td>
              <td class="px-4 py-3 text-end font-mono text-[13px] tabular-nums text-body"><%= number_with_delimiter(totals[:pending_embeddings]) %></td>
              <td class="px-4 py-3 text-end font-mono text-[13px] tabular-nums <%= totals[:with_errors].positive? ? 'text-red-700' : 'text-body' %>"><%= number_with_delimiter(totals[:with_errors]) %></td>
              <td class="py-3 pe-0 text-end">
                <button type="button" class="inline-flex h-8 w-8 items-center justify-center rounded-md text-muted hover:bg-cream-200"
                        aria-label="<%= t('views.organisations.ai_sync_statuses.show.toggle_details', project: project_stats[:project].name) %>">
                  <i class="bi bi-chevron-down text-xs transition-transform duration-200" data-toggle-target="icon" aria-hidden="true"></i>
                </button>
              </td>
            </tr>
            <tr class="hidden" data-toggle-target="content">
              <td colspan="5" class="pb-5 ps-0 pe-0">
                <%# One row per registered content type, in registry order. The list is
                    NOT written here: Embeddings::ContentTypes owns it, the service keys
                    its rows by it, and AiSyncStatusHelper says how to draw each key. %>
                <table class="min-w-full border-collapse rounded-lg bg-surface">
                  <thead>
                    <tr>
                      <% [[:col_type, 'text-start'], [:total, 'text-end'], [:enabled, 'text-end'], [:processed, 'text-end'],
                          [:pending, 'text-end'], [:errors, 'text-end'], [:fragments, 'text-end']].each do |key, align| %>
                        <th scope="col" class="column-head border-b border-cream-300 px-3 py-2 <%= align %>">
                          <%= t("views.organisations.ai_sync_statuses.show.#{key}") %>
                        </th>
                      <% end %>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-cream-200">
                    <% project_stats[:by_type].each do |key, data| %>
                      <tr data-type-card="<%= key %>">
                        <th scope="row" class="px-3 py-2 text-start text-sm font-normal text-body">
                          <i class="bi bi-<%= ai_sync_type_presentation(key)[:icon] %> mr-1.5 text-cream-600" aria-hidden="true"></i><%= ai_sync_type_label(key) %>
                        </th>
                        <% [data[:total], data[:embeddings_enabled], data[:embeddings_processed], data[:pending_embeddings]].each do |value| %>
                          <td class="px-3 py-2 text-end font-mono text-[13px] tabular-nums text-body"><%= number_with_delimiter(value) %></td>
                        <% end %>
                        <td class="px-3 py-2 text-end font-mono text-[13px] tabular-nums <%= data[:with_errors].positive? ? 'text-red-700' : 'text-body' %>" data-type-errors><%= number_with_delimiter(data[:with_errors]) %></td>
                        <td class="px-3 py-2 text-end font-mono text-[13px] tabular-nums text-body"><%= number_with_delimiter(data[:fragments_with_embeddings]) %>/<%= number_with_delimiter(data[:fragments_count]) %></td>
                      </tr>
                    <% end %>
                  </tbody>
                  <tfoot>
                    <tr class="border-t border-cream-300">
                      <th scope="row" class="px-3 py-2 text-start text-sm font-semibold text-heading"><%= t('views.organisations.ai_sync_statuses.show.total') %></th>
                      <td class="px-3 py-2 text-end font-mono text-[13px] tabular-nums text-heading" data-project-total><%= number_with_delimiter(totals[:total]) %></td>
                      <% [totals[:embeddings_enabled], totals[:embeddings_processed], totals[:pending_embeddings]].each do |value| %>
                        <td class="px-3 py-2 text-end font-mono text-[13px] tabular-nums text-heading"><%= number_with_delimiter(value) %></td>
                      <% end %>
                      <td class="px-3 py-2 text-end font-mono text-[13px] tabular-nums <%= totals[:with_errors].positive? ? 'text-red-700' : 'text-heading' %>"><%= number_with_delimiter(totals[:with_errors]) %></td>
                      <td></td>
                    </tr>
                  </tfoot>
                </table>
              </td>
            </tr>
          </tbody>
        <% end %>
      </table>
    <% else %>
      <p class="text-sm text-muted"><%= t('views.organisations.ai_sync_statuses.show.no_projects') %></p>
    <% end %>
  </section>

  <section aria-labelledby="ai-sync-fragments">
    <h2 id="ai-sync-fragments" class="mb-3 text-sm font-semibold text-heading">
      <%= t('views.organisations.ai_sync_statuses.show.fragment_statistics') %>
    </h2>
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
      <div>
      <p class="mb-2 text-xs text-muted"><%= t('views.organisations.ai_sync_statuses.show.by_content_type') %></p>
      <% if @sync_statistics[:fragments][:by_type].any? %>
      <table class="min-w-full border-collapse">
        <thead>
          <tr>
            <th scope="col" class="column-head border-b border-ink py-2 pe-4 text-start"><%= t('views.organisations.ai_sync_statuses.show.col_type') %></th>
            <th scope="col" class="column-head border-b border-ink px-4 py-2 text-end"><%= t('views.organisations.ai_sync_statuses.show.total') %></th>
            <th scope="col" class="column-head border-b border-ink py-2 ps-4 text-end"><%= t('views.organisations.ai_sync_statuses.show.with_embeddings') %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-cream-200">
          <% @sync_statistics[:fragments][:by_type].each do |type, count| %>
            <tr>
              <th scope="row" class="py-2 pe-4 text-start text-sm font-normal text-body"><%= type %></th>
              <td class="px-4 py-2 text-end font-mono text-[13px] tabular-nums text-body"><%= number_with_delimiter(count) %></td>
              <td class="py-2 ps-4 text-end font-mono text-[13px] tabular-nums text-body"><%= number_with_delimiter(@sync_statistics[:fragments][:with_embeddings_by_type][type] || 0) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <% else %>
        <p class="text-sm text-muted"><%= t('views.organisations.ai_sync_statuses.show.no_fragments') %></p>
      <% end %>
      </div>

      <div>
        <p class="mb-2 text-xs text-muted"><%= t('views.organisations.ai_sync_statuses.show.recent_fragments') %></p>
        <% if @sync_statistics[:fragments][:recent_fragments].any? %>
          <table class="min-w-full border-collapse">
            <thead>
              <tr>
                <th scope="col" class="column-head border-b border-ink py-2 pe-4 text-start"><%= t('views.organisations.ai_sync_statuses.show.col_type') %></th>
                <th scope="col" class="column-head border-b border-ink px-4 py-2 text-start"><%= t('views.organisations.ai_sync_statuses.show.col_created') %></th>
                <th scope="col" class="column-head border-b border-ink py-2 ps-4 text-start"><%= t('views.organisations.ai_sync_statuses.show.col_embedding') %></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-cream-200">
              <% @sync_statistics[:fragments][:recent_fragments].each do |fragment| %>
                <%# Embedded = has a sidecar row (see the service): the inline column
                    only ever holds 1536-dim vectors and is NULL for a 768/1024 org. %>
                <% embedded = @sync_statistics[:fragments][:recent_fragment_ids_with_embedding].include?(fragment.id) %>
                <tr>
                  <th scope="row" class="py-2 pe-4 text-start text-sm font-normal text-body"><%= fragment.fragmentable_type %></th>
                  <td class="px-4 py-2 font-mono text-[13px] tabular-nums text-muted whitespace-nowrap"><%= display_time(fragment.created_at) %></td>
                  <td class="py-2 ps-4 text-sm <%= embedded ? 'text-body' : 'text-red-700' %>">
                    <i class="bi bi-<%= embedded ? 'check2' : 'x-lg' %> mr-1" aria-hidden="true"></i><%= embedded ? t('views.organisations.ai_sync_statuses.show.with_embedding') : t('views.organisations.ai_sync_statuses.show.without_embedding') %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <p class="text-sm text-muted"><%= t('views.organisations.ai_sync_statuses.show.no_fragments') %></p>
        <% end %>
      </div>
    </div>
  </section>

  <%# The two buttons that stood at the foot have moved INTO the summary at the top of the
      page (S4, §3.5): the action belongs next to the sentence that motivates it. %>
  </div>
</div>
