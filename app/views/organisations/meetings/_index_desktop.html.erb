<%# locals: (list:) %>
<%# Desktop two-column master-detail (list + detail frame), mirroring Knowledge.
    Shared by the project page and "Alle Meetings": list is the page's own head
    and results, and the results partial brings its own list frame. %>
<%= render NeoTwoColumnGridComponent.new(
  selected_item: @selected_meeting || @new_meeting,
  context_type: :meetings,
  css_classes: "#{@selected_meeting || @new_meeting ? 'show-content' : 'hide-content'} hide-panel",
  additional_targets: { "index-page-target" => "layout", "column-picker-target" => "grid" },
  chrome_height: NeoTwoColumnGridComponent::LANE_CHROME_HEIGHT_PX,
  lane: true
) do |grid| %>
  <% grid.with_list do %>
    <%= list %>
  <% end %>

  <% grid.with_side_panel do %>
    <%= render 'organisations/meetings/column_picker' %>
  <% end %>

  <% grid.with_main_content do %>
    <%# No data-turbo-action="advance": list-row owns the canonical
        …/meetings?meeting_id=… page address. %>
    <turbo-frame id="meeting_display_frame">
      <% if @new_meeting %>
        <%= render (@new_meeting.persisted? ? 'organisations/meetings/meeting_edit' : 'organisations/meetings/meeting_new_for_frame'), meeting: @new_meeting, detail_frame_id: 'meeting_display_frame' %>
      <% else %>
        <%= render 'organisations/meetings/display_meeting', selected_meeting: @selected_meeting %>
      <% end %>
    </turbo-frame>
  <% end %>

<% end %>
