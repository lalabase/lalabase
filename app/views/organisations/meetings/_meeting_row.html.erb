<%# locals: (meeting:, selected_meeting: nil, opens_in_lane: true) %>
<%
  selected_id = selected_meeting&.id || params[:meeting_id]
  is_selected = selected_id == meeting.id
  # The project page opens the meeting in its lane; "Alle Meetings" has none
  # yet and opens it on the meeting's own project page, the title a real link
  # for the keyboard (clickable-row leaves clicks on a link alone).
  detail_url = opens_in_lane ? organisation_project_meeting_path(@current_organisation, @project, meeting) : organisation_project_meetings_path(@current_organisation, meeting.project, meeting_id: meeting.id)
  row_data = if opens_in_lane
               { controller: 'list-row', list_row_url_value: detail_url, list_row_id_value: meeting.id, list_row_param_value: 'meeting_id',
                 list_row_params_value: %w[meeting_id].to_json, list_row_frame_value: 'meeting_display_frame',
                 meetings_row_item_id_value: meeting.id, meeting_id: meeting.id, action: 'click->list-row#click' }
             else
               { controller: 'clickable-row', clickable_row_url_value: detail_url, meeting_id: meeting.id, action: 'click->clickable-row#click' }
             end
  # Cell widths MUST stay in sync with the <th> widths in _meetings_table.
%>
<%= tag.tr data: row_data, tabindex: (-1 if opens_in_lane),
           class: "transition-colors duration-100 ease-in-out cursor-pointer focus:outline-none hover:bg-cream-100 #{'selected-row' if is_selected}" do %>
  <% @columns.each do |column| %>
    <td data-column="<%= column[:key] %>" <%= tag.attributes(data: { rank: column[:rank] }) %>
        style="<%= column_min_width_style(column) %>" class="p-3 text-sm <%= column[:required] ? 'title-column' : column_align_class(column) %>">
      <% if column[:key] == 'title' %>
        <h5 class="text-sm font-medium truncate">
          <%= opens_in_lane ? meeting.title : link_to(meeting.title, detail_url, data: { turbo_frame: '_top' }, class: 'text-cream-900 hover:text-ink hover:underline') %>
        </h5>
        <div class="ticket-meta text-[11px] text-muted truncate">
          <% @columns.reject { |item| item[:required] }.each do |item| %>
            <% value = meeting_column_value(meeting, item) %>
            <span class="ticket-meta__item" data-rank="<%= item[:rank] %>" <%= 'hidden' unless item[:pinned] && value.present? %> title="<%= item[:label] %>"><%= value %></span>
          <% end %>
        </div>
      <% else %>
        <%= tag.div meeting_column_value(meeting, column), class: 'truncate', title: strip_tags(meeting_column_value(meeting, column).to_s) %>
      <% end %>
    </td>
  <% end %>
<% end %>
