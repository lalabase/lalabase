<%
  selected_id = (defined?(selected_meeting) && selected_meeting&.id) || params[:meeting_id]
  is_selected = selected_id == meeting.id
  detail_url = organisation_project_meeting_path(@current_organisation, @project, meeting)
  # Cell widths MUST stay in sync with the <th> widths in _meetings_results.
%>
<tr
  data-controller="list-row"
  data-list-row-url-value="<%= html_escape(detail_url) %>"
  data-list-row-id-value="<%= meeting.id %>"
  data-list-row-param-value="meeting_id"
  data-list-row-params-value="<%= %w[meeting_id].to_json %>"
  data-list-row-frame-value="meeting_display_frame"
  data-meetings-row-item-id-value="<%= meeting.id %>"
  data-meeting-id="<%= meeting.id %>"
  data-action="click->list-row#click"
  class="transition-colors duration-100 ease-in-out cursor-pointer focus:outline-none hover:bg-cream-100 <%= 'selected-row' if is_selected %>"
  tabindex="-1">
  <% @columns.each do |column| %>
    <td data-column="<%= column[:key] %>" <%= tag.attributes(data: { rank: column[:rank] }) %>
        style="<%= column_min_width_style(column) %>" class="p-3 text-sm <%= column[:required] ? 'title-column' : column_align_class(column) %>">
      <% if column[:key] == 'title' %>
        <h5 class="text-sm font-medium truncate"><%= meeting.title %></h5>
        <div class="ticket-meta text-[11px] text-muted truncate">
          <% @columns.reject { |item| item[:required] }.each do |item| %>
            <% value = meeting_column_value(meeting, item) %>
            <span class="ticket-meta__item" data-rank="<%= item[:rank] %>" <%= 'hidden' unless item[:pinned] && value.present? %> title="<%= item[:label] %>"><%= value %></span>
          <% end %>
        </div>
      <% else %>
        <%= tag.div meeting_column_value(meeting, column), class: 'truncate', title: strip_tags(meeting_column_value(meeting, column).to_s) %>
      <% end %>
    </td>
  <% end %>
</tr>
