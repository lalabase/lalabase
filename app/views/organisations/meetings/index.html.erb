<%# Meetings (Gespräche) master-detail — Slice 1a. List left, detail in a Turbo
    frame right; layout-toggle + viewport drive the list/detail switch (desktop
    collapse + mobile). Search reloads only the list frame so the detail pane
    survives. %>
<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-cache">
  <%# Keep Turbo visits alive: a full reload discards the permanent assistant's
      draft and selected revision. index-page restores meeting/filter/form
      history; no-cache above keeps stale detail snapshots out of that history. %>
<% end %>

<turbo-frame id="modal"></turbo-frame>

<div class="labor-layout-view <%= 'show-content' if @selected_meeting || @new_meeting %> hide-panel"
     data-controller="layout-toggle hover-arrows index-page keyboard-navigation viewport column-picker"
     <%= tag.attributes(data: meeting_column_picker_data(project: @project, frame_id: 'meetings_results')) %>
     data-hover-arrows-layout-toggle-outlet=".labor-layout-view"
     data-layout-toggle-list-frame-ids-value="<%= ['meetings_results'].to_json %>"
     data-layout-toggle-detail-frame-id-value="meeting_display_frame"
     data-layout-toggle-content-selector-value=".meeting-content"
     data-layout-toggle-selected-row-selector-value=".selected-row[data-meeting-id]"
     data-layout-toggle-selection-params-value="<%= %w[meeting_id].to_json %>"
     data-layout-toggle-list-filter-params-value="<%= Meetings::ListState::KEYS.to_json %>"
     data-layout-toggle-storage-key-value="layoutState:meetings"
     data-layout-toggle-clear-detail-on-close-value="true"
     data-viewport-breakpoint-value="1024"
     data-index-page-param-name-value="meeting_id"
     data-index-page-frame-id-value="meeting_display_frame"
     data-index-page-content-selector-value=".meeting-content"
     data-index-page-placeholder-id-value="meeting-display-placeholder"
     data-index-page-placeholder-class-value="ticket-placeholder px-4"
     data-index-page-placeholder-title-value="<%= t('views.organisations.meetings.index.placeholder_title') %>"
     data-index-page-placeholder-body-value="<%= t('views.organisations.meetings.index.placeholder_body') %>"
     data-index-page-selected-row-selector-value=".selected-row[data-meeting-id]"
     data-index-page-skip-if-content-visible-value="true"
     data-viewport-current-mode-value="<%= @viewport_mode %>"
     data-index-url="<%= organisation_project_meetings_path(@current_organisation, @project) %>"
     data-lane-params="<%= lane_params_json(selection: %w[meeting_id], form: %w[new]) %>">

  <% if @viewport_mode == 'mobile' %>
    <%= render 'organisations/meetings/index_mobile' %>
  <% else %>
    <%= render 'organisations/meetings/index_desktop' %>
  <% end %>
</div>
