<%# locals: () %>
<%# The project page's grid (meetings/_index_desktop): the list with its head,
    and the column picker in the side panel. The lane stays empty and shut
    until PR 3 of meetings_uebersicht_vereinheitlichen_plan.md opens a meeting
    in it; a row opens the meeting on its project's page meanwhile. %>
<%= render NeoTwoColumnGridComponent.new(
  context_type: :meetings,
  css_classes: 'hide-content hide-panel',
  additional_targets: { 'column-picker-target' => 'grid' },
  chrome_height: NeoTwoColumnGridComponent::LANE_CHROME_HEIGHT_PX,
  lane: true
) do |grid| %>
  <% grid.with_list do %>
    <%= render 'organisations/meetings_overview/list_head' %>
    <%= render 'organisations/meetings_overview/results', meetings: @meetings, first_use: meetings_overview_first_use? %>
  <% end %>

  <% grid.with_side_panel do %>
    <%= render 'organisations/meetings/column_picker' %>
  <% end %>
<% end %>
