<%# locals: () %>
<%# The head of "Alle Meetings": the title box, the claim hint and the shared
    filter bar. All of it stays outside #meetings_overview_results, so a filter,
    a sort or a page reloads only the rows and never the controls that asked for
    it (the same rule as meetings/_list_head). The sentence frame of the bar is
    answered from this partial too (MeetingsOverviewController#index). %>
<%# The shared title box (like "Zeiten" and the other overview pages) keeps the
    h1 typography consistent app-wide. The "?" carries the contextual meetings
    help, same wiring as the project page. %>
<%= render NeoTitleBoxComponent.new(
  title: t('views.organisations.meetings_overview.index.title'),
  variant: :organisation
) do |box| %>
  <%# Same square primary "+" as the project meetings page and the Zeiten list.
      Only where this person may write meetings somewhere: a button that leads
      to an error message is a promise without cover. %>
  <% if can_create_meeting? %>
    <% box.with_title_action do %>
      <%= render 'organisations/meetings_overview/new_meeting_modal', projects: writable_meeting_projects %>
    <% end %>
  <% end %>
  <% box.with_right_content do %>
    <%= render 'common/contextual_help_menu', context: :meetings %>
  <% end %>
<% end %>

<%# Claim hint (Nachtrag): outside the results frame so a filter never wipes it. %>
<%= render 'organisations/meetings/claim_suggestions', matches: meeting_claim_matches %>

<% unless meetings_overview_first_use? %>
  <%# The words of the bar are the project page's (i18n_scope): the same list,
      the same sentence. Only the category "Projekt" is this page's own. %>
  <%= render NeoFilterBarComponent.new(
    current_user_id: current_user.id,
    smart_folders: @meeting_smart_folders,
    url: organisation_meetings_path(@current_organisation),
    frame_id: Organisations::MeetingsOverviewController::LIST_FRAME_ID,
    i18n_scope: 'views.organisations.meetings.index',
    all_items_label: t('smart_folders.all_meetings'),
    smart_folder_context_type: 'Meeting',
    smart_folder_return_to: 'meetings',
    save_target_object_type: 'Meeting',
    return_params: meeting_list_state,
    return_keys: Meetings::ListState::KEYS,
    active_smart_folder: @active_smart_folder,
    active_view_permissions: filter_bar_view_permissions(@active_smart_folder),
    dissolver_result: @dissolver_result,
    ad_hoc_filters: ad_hoc_filter_params,
    ad_hoc_operators: ad_hoc_filter_op_params,
    dropped_categories: dropped_filter_categories,
    filter_categories_json: meeting_filter_categories_json(scope: policy_scope(Meeting), organisation: @current_organisation,
                                                           projects: meeting_filter_projects),
    search_value: params[:search],
    search_mode: @current_search_mode,
    search_modes: %w[title_only content],
    organisation: @current_organisation
  ) %>
<% end %>
