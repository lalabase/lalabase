<%# locals: (projects:) %>
<%# "Neues Meeting" on the org-wide list. A meeting always belongs to a project, so
    the modal picks one FIRST and only then loads the form for it. The frame below
    the select is filled by the project-nested MeetingsController#new (frame:
    'modal') with the SAME partial the project page uses, so participants, the LLM
    detection and the search opt-in behave identically -- there is no second copy of
    the meeting form.

    Each <option> carries its own new-URL, built here by ERB. meeting_modal_controller
    merges the filter row's CURRENT values into it before setting the frame's src: the
    values baked in below are only the ones from this page load, and the filter row is
    a frame-scoped GET that never re-renders this modal. No route is assembled in
    JavaScript, only values are set.
    The project filter travels as overview_project_id: `project_id` is the nested
    route's own parameter and would collide. %>
<div data-controller="meeting-modal"
     data-meeting-modal-filter-form-value="meetings-overview-filters"
     data-action="keydown@window->meeting-modal#closeOnEscape keydown@window->meeting-modal#trapFocus">

  <%= render Neo::Buttons::IconButtonComponent.new(
    variant: :primary,
    icon: 'plus-lg',
    size: :medium,
    title: t('views.organisations.meetings_overview.index.new_meeting'),
    data: { action: 'click->meeting-modal#open' }
  ) %>

  <div class="fixed z-modal inset-0 overflow-y-auto hidden"
       data-meeting-modal-target="modal">
    <%# The click-to-close action sits on the two elements that actually receive the
        click. On the container it could never fire: these two cover it completely,
        so event.target was never event.currentTarget. %>
    <div class="fixed inset-0 bg-ink bg-opacity-60 backdrop-blur-sm"
         data-action="click->meeting-modal#closeOnBackdrop"></div>
    <div class="flex items-center justify-center min-h-screen pt-4 px-4 pb-20 text-center"
         data-action="click->meeting-modal#closeOnBackdrop">
      <div class="inline-block align-bottom bg-surface-raised rounded-lg text-left overflow-hidden border border-cream-300 shadow-[4px_4px_0_0_#14110c] transform transition-all sm:my-8 sm:align-middle w-full relative" style="max-width: 720px;"
           data-meeting-modal-target="card"
           role="dialog"
           aria-modal="true"
           aria-labelledby="meeting-modal-title">
        <div class="bg-surface-raised px-4 pt-5 pb-4 sm:p-6 sm:pb-4 max-h-[85vh] overflow-y-auto">
          <div class="flex justify-between items-center mb-4">
            <h3 id="meeting-modal-title" class="text-lg leading-6 font-medium text-cream-900">
              <%= t('views.organisations.meetings_overview.index.modal_title') %>
            </h3>
            <%= render Neo::Buttons::IconButtonComponent.new(
              variant: :plain,
              icon: 'x-lg',
              class: 'opacity-50 hover:opacity-100',
              title: t('views.organisations.meetings_overview.index.modal_close'),
              data: { action: 'click->meeting-modal#close' }
            ) %>
          </div>

          <%# Outside the frame on purpose: the select must survive every frame load,
              because it is the one control that decides what the frame shows. %>
          <div class="mb-4">
            <label for="meeting-modal-project" class="block text-sm font-medium text-cream-700 mb-1">
              <%= t('views.organisations.meetings_overview.index.modal_project_label') %>
            </label>
            <select id="meeting-modal-project"
                    data-meeting-modal-target="projectSelect"
                    data-action="change->meeting-modal#projectChanged"
                    class="block w-full py-2 px-4 border border-cream-300 rounded-lg bg-surface-raised focus:outline-none focus:border-ink focus:ring-1 focus:ring-ink">
              <option value=""><%= t('views.organisations.meetings_overview.index.modal_project_prompt') %></option>
              <% projects.each do |project| %>
                <option value="<%= project.id %>"
                        data-new-url="<%= new_organisation_project_meeting_path(
                          @current_organisation, project,
                          frame: 'modal',
                          search: overview_filter_params[:search],
                          participant: overview_filter_params[:participant],
                          overview_project_id: overview_filter_params[:project_id]
                        ) %>"><%= project.name %></option>
              <% end %>
            </select>
          </div>

          <%# frame-error: a denied write, a deleted project or an expired session
              answers this frame with a redirect. Without it Turbo blanks the frame to
              its bare "Content missing" and throws; with it the reader gets a message
              and a way back. Same wiring as tickets/_tickets_results.html.erb. %>
          <turbo-frame id="meeting_modal_form"
                       data-meeting-modal-target="frame"
                       data-controller="frame-error">
            <p class="py-10 text-center text-sm text-cream-500">
              <%= t('views.organisations.meetings_overview.index.modal_select_project_first') %>
            </p>
          </turbo-frame>
        </div>
      </div>
    </div>
  </div>
</div>
