<%# locals: (meetings:, first_use: false) %>
<%# The meetings_overview_results frame, brought by this partial ITSELF: the
    filter bar, the column heads and the pages reload it, and
    MeetingsController#create REPLACES it after a save from the overview modal. A
    partial without the frame would leave a plain <div> behind, and from then on
    every reload would target a frame that no longer exists.
    Rendered from two controllers, so it reads no helper only one of them has:
    first_use is a local (false after a save, there is a meeting then).

    data-list-filter-query is the list state as the server applied it; the
    modal's "+" reads it when a project is chosen (meeting_modal_controller), so
    the list after a save keeps its conditions, view, search and sort. %>
<% frame_id = Organisations::MeetingsController::OVERVIEW_LIST_FRAME_ID %>
<% base_path = organisation_meetings_path(@current_organisation) %>
<turbo-frame id="<%= frame_id %>">
  <%# One query, not two: .empty? on an unloaded relation asks the database, then
      the loop asks it again. %>
  <% rows = meetings.to_a %>
  <div data-fb-hits-total="<%= @pagy.count %>" class="text-base min-h-[60vh]" data-list-filter-query="<%= meeting_list_state(pagy: @pagy).to_query %>">
    <% if rows.empty? %>
      <div class="flex items-center justify-center min-h-[40vh]">
        <% if first_use %>
          <%# No readable meetings exist yet in any project. %>
          <%= render 'shared/empty_content',
              variant: :first_time,
              icon_class: 'bi bi-chat-quote',
              title: t('views.organisations.meetings_overview.index.empty_first_time_title'),
              description: t('views.organisations.meetings_overview.index.empty_first_time_description') %>
        <% else %>
          <%# Meetings exist, but the view, a condition or the search matched none. %>
          <%= render 'shared/empty_content',
              variant: :no_results,
              icon_class: 'bi bi-search',
              title: t('views.organisations.meetings.index.empty_no_results') %>
        <% end %>
      </div>
    <% elsif @viewport_mode == 'mobile' %>
      <%# Phone: one block per meeting, the title on its own line and the project,
          date and participants below it. No table, so nothing scrolls sideways. %>
      <ul class="divide-y divide-cream-200">
        <% rows.each do |meeting| %>
          <% row_url = organisation_project_meetings_path(@current_organisation, meeting.project, meeting_id: meeting.id) %>
          <li data-meeting-id="<%= meeting.id %>"
              data-controller="clickable-row"
              data-clickable-row-url-value="<%= row_url %>"
              data-action="click->clickable-row#click"
              class="px-3 py-3 cursor-pointer hover:bg-cream-100">
            <h5 class="text-sm font-medium truncate">
              <%= link_to meeting.title, row_url, data: { turbo_frame: '_top' }, class: 'text-cream-900 hover:text-ink hover:underline' %>
            </h5>
            <p class="text-[11px] text-muted truncate">
              <%= safe_join([meeting.project.name,
                             display_time(meeting.occurred_at, user: current_user),
                             meeting_column_value(meeting, { key: 'participants' }).presence].compact, ' · ') %>
            </p>
          </li>
        <% end %>
      </ul>
    <% else %>
      <div class="relative w-full">
        <table class="w-full table-fixed meeting-table">
          <thead>
            <tr>
              <% @columns.each do |column| %>
                <th scope="col" data-column="<%= column[:key] %>"
                    class="py-3 px-3 text-start text-[11px] font-mono font-medium uppercase tracking-wider text-muted <%= meeting_overview_column_width_class(column) %>">
                  <%= meeting_sort_link(column, base_path: base_path, frame_id: frame_id) %>
                </th>
              <% end %>
            </tr>
          </thead>
          <tbody>
            <% rows.each do |meeting| %>
              <% row_url = organisation_project_meetings_path(@current_organisation, meeting.project, meeting_id: meeting.id) %>
              <%# A row opens the meeting on its project's page (clickable-row's
                  default branch navigates the window). The title stays a real
                  link for keyboard access; the controller ignores clicks on it. %>
              <tr data-meeting-id="<%= meeting.id %>"
                  data-controller="clickable-row"
                  data-clickable-row-url-value="<%= row_url %>"
                  data-action="click->clickable-row#click"
                  class="transition-colors duration-100 ease-in-out cursor-pointer hover:bg-cream-100">
                <% @columns.each do |column| %>
                  <td data-column="<%= column[:key] %>" class="p-3 text-sm">
                    <% if column[:key] == 'title' %>
                      <h5 class="text-sm font-medium truncate">
                        <%= link_to meeting.title, row_url, data: { turbo_frame: '_top' }, class: 'text-cream-900 hover:text-ink hover:underline' %>
                      </h5>
                    <% else %>
                      <% value = meeting_column_value(meeting, column) %>
                      <%= tag.div value, class: 'truncate', title: strip_tags(value.to_s) %>
                    <% end %>
                  </td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
    <% if @pagy.count.positive? %>
      <%= render 'shared/pagination_nav_compact', pagy: @pagy, frame_id: frame_id, items_per_page: @pagy.limit,
                 smart_folder_id: @active_smart_folder&.id, current_organisation: @current_organisation, base_path: base_path %>
    <% end %>
  </div>
</turbo-frame>
