<%# locals: (action_type:) %>
<%# The toast after an action on a row: one owner for the inbox of an
    organisation (update.turbo_stream.erb) and the inbox above the
    organisations (all_inboxes/update.turbo_stream.erb). %>
<div class="notification-toast notification-toast--success"
     data-controller="auto-dismiss"
     data-auto-dismiss-delay-value="3000">
  <div class="notification-toast-content">
    <% case action_type %>
    <% when 'archive' %>
      <i class="bi bi-archive-fill" aria-hidden="true"></i>
      <span><%= t('views.organisations.notifications.update.notification_archived') %></span>
    <% when 'read', 'mark_read' %>
      <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
      <span><%= t('views.organisations.notifications.update.marked_as_read') %></span>
    <% else %>
      <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
      <span><%= t('views.organisations.notifications.update.notification_updated') %></span>
    <% end %>
  </div>
</div>
