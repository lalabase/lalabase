<%# Inbox master list: the sole render path for both the initial page AND
    the Turbo Stream refresh after state changes (stable id
    "inbox_master_list"). One hairline above the rows, rows on the page's
    ground, as on the other list pages; the grouped view sets a quiet period
    heading (Heute, Gestern, Diese Woche, Älter) above its rows.
    Locals: presenter (Inbox::MasterListPresenter), selected_notification,
    query_context (optional, for turbo_stream re-renders), organisation_names
    (optional, { id => name }: the inbox above the organisations, where a row
    names its organisation). %>
<div id="inbox_master_list"
     class="people-list inbox-list"
     data-controller="neo-endless-scroll"
     data-action="<%= 'submit->neo-endless-scroll#preservePages' if inbox_above_organisations? %>"
     data-neo-endless-scroll-url-value="<%= inbox_list_path %>"
     data-neo-endless-scroll-first-page-value="<%= presenter.first_page %>"
     data-neo-endless-scroll-page-value="<%= presenter.pagy.page %>"
     data-neo-endless-scroll-has-more-value="<%= presenter.pagy.next.present? %>">
  <% query_context = local_assigns[:query_context] %>
  <% if inbox_above_organisations? %>
    <% query_context = (query_context || request.query_parameters).to_h.merge('page' => presenter.first_page) %>
  <% end %>
  <% selected_id = local_assigns[:selected_notification]&.id %>
  <% organisation_names = local_assigns[:organisation_names] %>

  <% if presenter.empty? %>
    <%# Why it is empty decides the sentence: an empty unread view is the
        good state ("Alles gelesen."), a search that found nothing offers to
        drop the narrowing. %>
    <% reason = presenter.empty_reason %>
    <div class="inbox-empty">
      <p class="inbox-empty__title">
        <% if reason == :all_read %><i class="bi bi-check2" aria-hidden="true"></i><% end %>
        <%= t("views.organisations.notifications.master_list.empty.#{reason}.title") %>
      </p>
      <p class="inbox-empty__body">
        <%= t("views.organisations.notifications.master_list.empty.#{reason}.body") %>
        <% case reason %>
        <% when :all_read %>
          <%= link_to t('views.organisations.notifications.master_list.empty.all_read.link'), inbox_status_view_url('all', query: query_context),
                      data: { turbo_frame: '_top' } %>
        <% when :no_match %>
          <%= link_to t('views.organisations.notifications.master_list.empty.no_match.link'), inbox_reset_narrowing_url(query: query_context),
                      data: { turbo_frame: '_top' } %>
        <% when :other_filter %>
          <%= link_to t('views.organisations.notifications.master_list.empty.other_filter.link'), inbox_status_view_url('all', query: query_context),
                      data: { turbo_frame: '_top' } %>
        <% end %>
      </p>
    </div>
  <% else %>
    <div data-neo-endless-scroll-target="container">
      <% if presenter.grouped? %>
        <% presenter.grouped_notifications.each do |period, reps| %>
          <%# data-date-header: the endless scroll drops a leading heading of
              the next page that repeats the last one shown. %>
          <h2 class="inbox-period" data-date-header="<%= period %>"><%= inbox_period_label(period) %></h2>
          <% reps.each do |notification| %>
            <div id="<%= dom_id(notification) %>" data-notification-item="<%= notification.id %>">
              <%= render NeoInboxMasterItemComponent.new(
                    notification: notification,
                    selected: selected_id == notification.id,
                    group_count: presenter.group_total(notification),
                    group_unread: presenter.group_unread(notification),
                    query_context: query_context,
                    organisation_name: organisation_names&.fetch(notification.organisation_id, nil)
                  ) %>
            </div>
          <% end %>
        <% end %>
      <% else %>
        <% presenter.notifications.each do |notification| %>
          <div id="<%= dom_id(notification) %>" data-notification-item="<%= notification.id %>">
            <%= render NeoInboxMasterItemComponent.new(notification: notification,
                                                       selected: selected_id == notification.id,
                                                       query_context: query_context,
                                                       organisation_name: organisation_names&.fetch(notification.organisation_id, nil)) %>
          </div>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <%# Sentinel: always in the DOM and visible (1px), observed by the
      IntersectionObserver. The loading indicator has no box and cannot be it. %>
  <div data-neo-endless-scroll-target="sentinel" class="h-px w-full"></div>

  <div data-neo-endless-scroll-target="loadingIndicator" class="hidden inbox-list__status">
    <span class="inline-block w-3 h-3 border-2 border-cream-300 border-t-ink rounded-full animate-spin" aria-hidden="true"></span>
    <%= t('views.organisations.notifications.master_list.loading_more') %>
  </div>

  <div data-neo-endless-scroll-target="endMessage" class="hidden inbox-list__status">
    <%= t('views.organisations.notifications.master_list.all_loaded') %>
  </div>
</div>
