<%# locals: (person:, message: nil) %>
<%# The form in the lane, new and edit. It leaves the frame (_top): a save
    lands on the list with the person open, a refused save renders the page
    again with this form and its reason. lock_version travels along, so a save
    over someone else's change is refused instead of overwriting it. The list
    state rides in hidden fields, so the list after a save keeps it. %>
<% url = person.persisted? ? organisation_person_path(@current_organisation, person) : organisation_people_path(@current_organisation) %>
<% input_class = 'block w-full py-2 px-3 border border-cream-300 rounded-lg bg-surface-raised focus:outline-none focus:border-ink focus:ring-1 focus:ring-ink' %>
<h2 class="text-[22px] leading-snug font-bold text-heading mb-4">
  <%= person.persisted? ? t('views.organisations.people.form.edit_title') : t('views.organisations.people.form.new_title') %>
</h2>

<% if message.present? %>
  <p class="mb-4 rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-800" role="alert"><%= message %></p>
<% end %>

<%= form_with model: person, url: url, scope: :person, class: 'people-form space-y-4', data: { turbo_frame: '_top' } do |f| %>
  <% list_state.each do |name, value| %>
    <%= hidden_field_tag name, value %>
  <% end %>
  <% if person.persisted? %>
    <%= f.hidden_field :lock_version %>
  <% end %>

  <div>
    <%= f.label :user_id, Person.human_attribute_name(:user), class: 'block text-sm font-medium text-cream-700 mb-1' %>
    <%= f.select :user_id, linkable_members_for(person).map { |user| [viewer_display_name(user), user.id] },
                 { include_blank: t('views.organisations.people.form.no_member') }, class: input_class %>
    <p class="mt-1 text-xs text-muted"><%= t('views.organisations.people.form.member_hint') %></p>
  </div>

  <div>
    <%= f.label :name, class: 'block text-sm font-medium text-cream-700 mb-1' %>
    <%# A linked row shows the member's own name; the copy here only shows once
        the link is gone, so it is not edited while linked. %>
    <%= f.text_field :name, class: input_class, maxlength: Person::MAX_FIELD_LENGTH, readonly: person.user_id.present? %>
  </div>

  <% %i[function department company].each do |field| %>
    <div>
      <%= f.label field, class: 'block text-sm font-medium text-cream-700 mb-1' %>
      <%= f.text_field field, class: input_class, maxlength: Person::MAX_FIELD_LENGTH %>
    </div>
  <% end %>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    <div>
      <%= f.label :email, class: 'block text-sm font-medium text-cream-700 mb-1' %>
      <%= f.email_field :email, class: input_class, maxlength: Person::MAX_FIELD_LENGTH %>
    </div>
    <div>
      <%= f.label :phone, class: 'block text-sm font-medium text-cream-700 mb-1' %>
      <%= f.telephone_field :phone, class: input_class, maxlength: Person::MAX_FIELD_LENGTH %>
    </div>
  </div>

  <div>
    <%= f.label :notes, class: 'block text-sm font-medium text-cream-700 mb-1' %>
    <%= f.text_area :notes, rows: 5, class: input_class, maxlength: Person::MAX_NOTES_LENGTH %>
  </div>

  <p class="text-xs text-muted"><i class="bi bi-eye" aria-hidden="true"></i> <%= t('views.organisations.people.form.shared_hint') %></p>

  <div class="flex items-center gap-3">
    <%= render Neo::Buttons::ButtonComponent.new(variant: :primary, size: :medium, type: 'submit') do %>
      <%= t('views.organisations.people.form.save') %>
    <% end %>
  </div>
<% end %>
