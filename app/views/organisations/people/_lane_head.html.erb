<%# locals: (kind_label:, edit_url: nil, edit_link: nil) %>
<%# The head of an open person: what it is (member, contact), "Bearbeiten" for
    those who may write, and the way out. The ✕ closes the lane in place
    (layout-toggle); on a phone the mobile view brings its own way back. %>
<div class="people-lane__head" data-lane-head data-lane-index-url="<%= organisation_people_path(@current_organisation) %>">
  <span class="people-lane__kind"><%= kind_label %></span>
  <% if edit_url || edit_link %>
    <%= link_to(edit_link ? edit_link[:href] : edit_url, class: 'people-ghost-action', data: edit_link&.dig(:data)) do %>
      <i class="bi bi-pencil" aria-hidden="true"></i><%= t('views.organisations.people.show.edit') %>
    <% end %>
  <% end %>
  <% unless @viewport_mode == 'mobile' %>
    <span class="people-lane__divider" aria-hidden="true"></span>
    <button type="button" class="people-icon-action" title="<%= t('views.organisations.people.show.close') %>"
            data-lane-close data-action="click->layout-toggle#closeContent">
      <i class="bi bi-x-lg" aria-hidden="true"></i>
    </button>
  <% end %>
</div>
