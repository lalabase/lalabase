<%# locals: (entry:, selected: nil, member: nil) %>
<% person = entry.person %>
<% name = person_display_name(person: person, user: entry.user) %>
<% if person %>
  <% url = organisation_person_path(@current_organisation, person) %>
  <% param, id = 'person_id', person.id %>
  <% open = selected&.id == person.id %>
<% else %>
  <% url = member_organisation_people_path(@current_organisation, entry.user.id) %>
  <% param, id = 'member_id', entry.user.id %>
  <% open = member&.id == entry.user.id %>
<% end %>
<% row_data = { controller: 'list-row', action: 'click->list-row#click', people_row: true,
                list_row_url_value: url, list_row_id_value: id, list_row_param_value: param,
                list_row_params_value: PeopleHelper::SELECTION_PARAMS.to_json,
                list_row_frame_value: Organisations::PeopleController::DETAIL_FRAME_ID } %>
<%= tag.li data: row_data, tabindex: 0, class: "people-row #{'selected-row' if open}" do %>
  <%= render Neo::Users::AvatarComponent.new(user: entry.user, size: :small, fallback_initials: person_initials(name),
                                              class: "people-avatar #{'people-avatar--contact' unless entry.member?}") %>
  <span class="people-row__text">
    <span class="people-row__line">
      <span class="people-row__name"><%= name %></span>
      <% if entry.member? %>
        <span class="people-badge"><%= t('views.organisations.people.index.member_badge') %></span>
      <% end %>
    </span>
    <% sub = [person&.function, person&.company].compact_blank.join(' · ').presence || (entry.user&.email if entry.member?) %>
    <% if sub %>
      <span class="people-row__sub"><%= sub %></span>
    <% end %>
  </span>
  <i class="bi bi-chevron-right people-row__chevron" aria-hidden="true"></i>
<% end %>
