<%# One answer for a project, ticket or meeting that is missing, not readable or of another
    organisation: it names none of them. %>
<%= turbo_frame_tag Organisations::TicketMeetingPanelsController::FRAME_ID do %>
  <div class="ticket-meeting-panel" data-controller="ticket-meeting-panel"
       data-ticket-meeting-panel-ticket-id-value="<%= params[:ticket_id].to_s %>">
    <p class="ticket-meeting-panel__empty"><%= t('views.organisations.tickets.meeting_panel.unavailable') %></p>
  </div>
<% end %>
