<%# locals: (ticket:, meeting:, meetings:, linked_tickets:) %>
<%# The meeting beside the ticket (doc/ticket_meeting_panel_plan.md, S1), the content of
    turbo-frame#ticket_meeting_panel in the grid's third lane. Read only: no edit, no delete,
    no analyses, no suggestions, no assistant entry point; "Open meeting" leads to the page
    where all of that lives.
    meetings: every meeting of this ticket the reader may see (Tickets::LinkedMeetings),
    newest first, as tabs in the head; a tab is a plain link, so it loads into this frame.
    The close button is the lane's own (NeoTwoColumnGridComponent, layout_toggle#togglePanel);
    ticket_meeting_panel_controller adds Escape and closes when the lane shows another ticket.
    ⚠️ Keys fully qualified: a lazy t('.') in a partial answers to the partial's name. %>
<% mp = 'views.organisations.tickets.meeting_panel' %>
<div class="ticket-meeting-panel"
     data-controller="ticket-meeting-panel"
     data-ticket-meeting-panel-ticket-id-value="<%= ticket.id %>">
  <header class="ticket-meeting-panel__head">
    <p class="text-xs font-mono uppercase tracking-wider text-cream-600"><%= t("#{mp}.eyebrow") %></p>
    <% if meetings.size > 1 %>
      <nav class="ticket-meeting-panel__tabs" aria-label="<%= t("#{mp}.tabs_label") %>">
        <% meetings.each do |other| %>
          <%= link_to organisation_project_ticket_meeting_panel_path(current_organisation, ticket.project, ticket, meeting_id: other.id),
                      class: 'ticket-meeting-panel__tab',
                      title: other.title,
                      aria: { current: (other == meeting ? 'true' : nil) } do %>
            <span class="font-mono tabular-nums"><%= l(other.occurred_at.to_date, format: :short) %></span>
            <span class="truncate"><%= other.title %></span>
          <% end %>
        <% end %>
      </nav>
    <% end %>
  </header>

  <h2 class="mt-3 text-lg font-bold leading-snug text-cream-900 break-words [overflow-wrap:anywhere]"><%= meeting.title %></h2>
  <p class="mt-2 inline-flex items-center gap-1.5 text-xs text-cream-600">
    <i class="bi bi-calendar3" aria-hidden="true"></i>
    <%= display_time(meeting.occurred_at, user: current_user) %>
  </p>

  <% participants = meeting.meeting_participants.order(:created_at).to_a %>
  <%= render 'organisations/meetings/participants_row', meeting: meeting, participants: participants %>

  <div class="border-b border-cream-300 mt-4 mb-5"></div>

  <%= render 'organisations/meetings/meeting_reading', meeting: meeting, participants: participants, panel: true %>

  <% if linked_tickets.any? %>
    <section class="mt-8">
      <h3 class="text-xs font-mono uppercase tracking-wider text-cream-600 mb-2">
        <%= t("#{mp}.linked_tickets") %>
      </h3>
      <ul class="divide-y divide-cream-200 border-t border-cream-200">
        <% linked_tickets.each do |other| %>
          <li class="flex items-center gap-3 py-2 text-sm">
            <span class="shrink-0 font-mono text-xs tabular-nums text-cream-500">#<%= other.number %></span>
            <% if other == ticket %>
              <span class="min-w-0 flex-1 truncate text-cream-900"><%= other.title %></span>
              <span class="shrink-0 text-xs italic text-cream-500"><%= t("#{mp}.this_ticket") %></span>
            <% elsif other.project_id == ticket.project_id %>
              <%# Opens in the lane the way a row does (list_row: the page address, the lane's
                  frame, the selection mark); the href is the page address for a new tab.
                  The lane then shows another ticket, and this panel closes (F3). %>
              <a href="<%= organisation_project_tickets_path(current_organisation, other.project, ticket_id: other.id) %>"
                 class="min-w-0 flex-1 truncate text-cream-900 hover:underline"
                 data-controller="list-row"
                 data-list-row-url-value="<%= organisation_project_ticket_path(current_organisation, other.project, other) %>"
                 data-list-row-id-value="<%= other.id %>"
                 data-list-row-param-value="ticket_id"
                 data-list-row-frame-value="ticket_display_frame"
                 data-action="click->list-row#click"><%= other.title %></a>
            <% else %>
              <%# Another project, another page: no lane of this one can show it. %>
              <%= link_to other.title,
                          organisation_project_tickets_path(current_organisation, other.project, ticket_id: other.id),
                          class: 'min-w-0 flex-1 truncate text-cream-900 hover:underline',
                          data: { turbo_frame: '_top' } %>
              <span class="shrink-0 truncate text-xs text-cream-500"><%= other.project.name %></span>
            <% end %>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <p class="mt-8">
    <%= link_to organisation_project_meetings_path(current_organisation, meeting.project, meeting_id: meeting.id),
                class: 'inline-flex items-center gap-1.5 text-sm font-medium text-cream-900 underline hover:text-ink',
                data: { turbo_frame: '_top' } do %>
      <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i>
      <%= t("#{mp}.open_meeting") %>
    <% end %>
  </p>
</div>
