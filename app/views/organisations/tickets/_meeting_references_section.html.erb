<%# locals: (ticket:) %>
<%# "Gespräche" backlinks on the ticket detail
    (Gespräche Slice 3): meetings that link TO this ticket. Sits between the
    sub-tasks section and the comment timeline, styled after _subtasks_section.

    GATE (here, per meeting, Tickets::LinkedMeetings): a meeting shows only to
    people who may read meetings in the MEETING's project, and its link names that
    project.
    A ticket moved to another project keeps its meeting links, so the ticket's
    project answers neither question. Somebody who may read none of the meetings
    does not learn that links exist: the section renders nothing without an entry,
    so it never appears empty.

    No tombstones on this side: a meeting owns its outgoing link (dependent:
    :destroy), so a backlink's source meeting always exists. %>
<% meetings = Tickets::LinkedMeetings.call(ticket: ticket, user: current_user).to_a %>
<% if meetings.any? %>
  <section id="meeting-references-<%= ticket.id %>" class="meeting-references-section mb-6">
    <ul class="divide-y divide-cream-200 overflow-hidden rounded-lg bg-cream-50">
      <% meetings.each do |meeting| %>
        <li class="flex items-center gap-3 px-3 py-2">
          <i class="bi bi-chat-quote shrink-0 text-xs text-cream-500" aria-hidden="true"></i>
          <%# _top: this section renders inside ticket_display_frame (the lane, on
              the list and on the board), but the meetings page has no frame with that id —
              without the escape Turbo renders "Content missing" instead of navigating. %>
          <%= link_to meeting.title,
                      organisation_project_meetings_path(@current_organisation, meeting.project, meeting_id: meeting.id),
                      class: 'flex-1 truncate text-sm text-cream-900 hover:underline',
                      data: { turbo_frame: '_top' } %>
          <span class="shrink-0 font-mono text-xs tabular-nums text-cream-500">
            <%= l(meeting.occurred_at.to_date, format: :default) %>
          </span>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>
