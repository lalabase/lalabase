<% content_for :title, t('user_data_export.title') %>

<%# The data export of the account area, in the shapes of the rest of the application
    (doc/belegungstabelle_oberflaeche.md): the shared page head, the content capped
    because one reads it line by line (.width-capped), sections as a quiet heading over
    their content, the state of the latest export as a part of the page that stays
    (F30), and one main action at a time (F1): the download while there is a file, else
    the request. Until 2026-11-12 the page was a centred card with a soft shadow, gray
    tones outside the token layer and a hand-built black button. %>
<% field_class = 'block w-full rounded border border-cream-300 bg-surface-raised px-3 py-2 text-sm text-body focus:outline-none focus:border-ink focus:ring-1 focus:ring-ink transition-all' %>
<% status_icons = { 'pending' => 'bi-hourglass-split', 'processing' => 'bi-arrow-repeat inline-block animate-spin',
                    'completed' => 'bi-check-circle', 'expired' => 'bi-clock-history', 'failed' => 'bi-exclamation-triangle' } %>
<% downloadable = @export&.downloadable? %>
<div>
  <%= render 'organisations/shared/subnav',
        title: t('user_data_export.title'),
        aria_label: t('user_data_export.title'),
        active: nil,
        tabs: [] %>

  <div class="width-capped space-y-8">
    <section aria-labelledby="data-export-contents">
      <h2 id="data-export-contents" class="sr-only"><%= t('user_data_export.contents_heading') %></h2>
      <p class="text-sm text-body"><%= t('user_data_export.intro') %></p>
      <ul class="mt-3 space-y-1.5 text-sm text-body">
        <% %w[includes_account includes_security includes_orgs].each do |key| %>
          <li class="flex gap-2">
            <i class="bi bi-check2 mt-0.5 text-cream-600" aria-hidden="true"></i>
            <span><%= t("user_data_export.#{key}") %></span>
          </li>
        <% end %>
      </ul>
      <p class="mt-3 text-sm text-muted"><%= t('user_data_export.org_content_note') %></p>
    </section>

    <% if @export.present? %>
      <%# The latest export: pending / processing / completed / expired / failed. %>
      <% status_key = @export.expired? ? 'expired' : @export.status %>
      <section aria-labelledby="data-export-status" class="rounded-lg border border-cream-300 bg-surface p-4"
               data-export-state="<%= status_key %>">
        <h2 id="data-export-status" class="flex items-center gap-2 text-sm font-semibold text-heading">
          <i class="bi <%= status_icons.fetch(status_key) %> <%= status_key == 'failed' ? 'text-red-700' : 'text-cream-600' %>" aria-hidden="true"></i>
          <%= t("user_data_export.status.#{status_key}.title") %>
        </h2>
        <p class="mt-1 text-sm text-body"><%= t("user_data_export.status.#{status_key}.hint") %></p>

        <% if downloadable %>
          <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2">
            <%= render Neo::Buttons::ButtonComponent.new(variant: :primary, size: :medium, icon: 'file-earmark-zip',
                                                         url: download_user_data_export_path) do %>
              <%= t('user_data_export.download_button') %>
            <% end %>
            <span class="text-xs text-muted">
              <%= t('user_data_export.valid_until', date: l(@export.expires_at, format: :long)) %>
            </span>
          </div>
        <% end %>
      </section>
    <% end %>

    <% unless @export&.pending? || @export&.processing? %>
      <section aria-labelledby="data-export-request" class="border-t border-cream-200 pt-6">
        <h2 id="data-export-request" class="text-sm font-semibold text-heading"><%= t('user_data_export.request_title') %></h2>
        <p class="mt-1 text-sm text-muted"><%= t('user_data_export.request_hint') %></p>

        <%= form_with url: user_data_export_path, method: :post, local: true, class: 'mt-4 space-y-5' do |form| %>
          <div>
            <%= form.label :current_password, t('user_data_export.password_label'),
                           class: 'mb-1 block text-sm font-medium text-cream-700' %>
            <%= form.password_field :current_password, autocomplete: 'current-password', required: true,
                                    'aria-describedby': 'data-export-password-hint', class: field_class %>
            <small id="data-export-password-hint" class="mt-1 block text-xs text-muted"><%= t('user_data_export.password_hint') %></small>
          </div>

          <%# The main action of the page unless a file is waiting: then the download is,
              and a second request is the quieter choice. %>
          <div class="flex justify-end">
            <%= render Neo::Buttons::ButtonComponent.new(variant: downloadable ? :secondary : :primary, size: :medium,
                                                         icon: 'download', tag: :button, type: 'submit') do %>
              <%= t('user_data_export.request_button') %>
            <% end %>
          </div>
        <% end %>
      </section>
    <% end %>
  </div>
</div>
