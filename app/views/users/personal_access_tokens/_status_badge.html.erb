<%# locals: (token:) %>
<%# The state of a token as a quiet sign and a word, not a coloured chip: the list
    is read for the names, and only an expired token asks for attention (amber).
    data-token-state names the state for specs. %>
<% state, icon, tone = if token.revoked?
                         ['revoked', 'x-circle', 'text-muted']
                       elsif token.expired?
                         ['expired', 'clock-history', 'text-amber-700']
                       else
                         ['active', 'check-circle', 'text-muted']
                       end %>
<span class="inline-flex items-center gap-1 whitespace-nowrap text-xs <%= tone %>" data-token-state="<%= state %>">
  <i class="bi bi-<%= icon %>" aria-hidden="true"></i>
  <%= t("views.users.personal_access_tokens.index.status_#{state}") %>
</span>
