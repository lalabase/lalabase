<%# The token just created: the one page that ever shows it. In the shapes of the rest
    of the application: the area's head with the crumb line, the warning as a flat
    notice (the amber of organisations/shared/_ai_disabled_notice), the token in a
    field with ONE main action beside it, the copy; the way back is the quiet one.
    Until 2026-11-12 warning and token were two cards with hard shadows, and the way
    back was the page's main action. %>
<div>
  <%= render 'head', page: t('views.users.personal_access_tokens.created.title') %>

  <div class="width-capped--wide space-y-6">
    <div class="flex items-start gap-3 rounded-lg border border-amber-300 bg-amber-50 p-4" role="alert">
      <i class="bi bi-exclamation-triangle mt-0.5 shrink-0 text-amber-700" aria-hidden="true"></i>
      <div>
        <h2 class="text-sm font-bold text-amber-900">
          <%= t('views.users.personal_access_tokens.created.warning_title') %>
        </h2>
        <p class="mt-1 text-sm text-amber-900">
          <%= t('views.users.personal_access_tokens.created.warning_body') %>
        </p>
      </div>
    </div>

    <section aria-labelledby="pat-created-token">
      <h2 id="pat-created-token" class="mb-1 block text-sm font-medium text-cream-700">
        <%= t('views.users.personal_access_tokens.created.token_label') %>
        <span class="font-normal text-muted">(<%= @token.name %>)</span>
      </h2>

      <div class="flex flex-wrap items-center gap-2"
           data-controller="clipboard"
           data-clipboard-success-text-value="<%= t('views.users.personal_access_tokens.created.copied') %>">
        <input type="text"
               readonly
               autocomplete="off"
               value="<%= @plaintext_token %>"
               aria-labelledby="pat-created-token"
               data-clipboard-target="source"
               class="block min-w-0 flex-1 select-all rounded border border-cream-300 bg-surface-raised px-3 py-2 font-mono text-sm text-body focus:outline-none focus:border-ink focus:ring-1 focus:ring-ink">
        <%= render Neo::Buttons::ButtonComponent.new(
              variant: :primary,
              size: :medium,
              icon: 'clipboard',
              data: { action: 'click->clipboard#copy', clipboard_target: 'button' }
            ) do %>
          <span data-clipboard-target="buttonLabel"><%= t('views.users.personal_access_tokens.created.copy') %></span>
        <% end %>
      </div>

      <dl class="mt-4 space-y-1 rounded-lg border border-cream-300 bg-surface p-4 text-sm">
        <div class="flex flex-wrap gap-x-2">
          <dt class="text-muted"><%= t('views.users.personal_access_tokens.created.scope_overview') %></dt>
          <dd class="text-body"><%= render 'scope_summary', token: @token %></dd>
        </div>
        <div class="flex flex-wrap gap-x-2">
          <dt class="text-muted"><%= t('views.users.personal_access_tokens.index.col_expires') %>:</dt>
          <dd class="tabular-nums text-body"><%= l(@token.expires_at, format: :short) %></dd>
        </div>
      </dl>
    </section>

    <div class="flex justify-end">
      <%= render Neo::Buttons::ButtonComponent.new(
            variant: :secondary,
            size: :medium,
            icon: 'arrow-left',
            url: users_personal_access_tokens_path
          ) do %>
        <%= t('views.users.personal_access_tokens.created.back_to_index') %>
      <% end %>
    </div>
  </div>
</div>
