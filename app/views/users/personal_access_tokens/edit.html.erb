<%# Renaming a token (and switching read-only), in the shapes of the rest of the
    application: the area's head with the crumb line, the form capped for reading,
    fields in the style of the account forms, what cannot be changed as a flat box
    below them. Until 2026-11-12 the form sat in a card with a hard shadow. %>
<% field_class = 'block w-full rounded border border-cream-300 bg-surface-raised px-3 py-2 text-sm text-body focus:outline-none focus:border-ink focus:ring-1 focus:ring-ink transition-all' %>
<% label_class = 'mb-1 block text-sm font-medium text-cream-700' %>
<% hint_class = 'mt-1 block text-xs text-muted' %>
<div>
  <%= render 'head', page: t('views.users.personal_access_tokens.edit.title') %>

  <div class="width-capped">
    <p class="mb-6 text-sm text-muted">
      <%= t('views.users.personal_access_tokens.edit.hint') %>
    </p>

    <%= form_with model: @token,
                  url: users_personal_access_token_path(@token),
                  method: :patch,
                  local: true,
                  data: { turbo: false },
                  class: "space-y-5" do |form| %>
      <div>
        <%= form.label :name, t('views.users.personal_access_tokens.new.name_label'), class: label_class %>
        <%= form.text_field :name, required: true, class: field_class %>
      </div>

      <div>
        <label class="flex cursor-pointer items-start gap-2">
          <%= form.check_box :read_only, class: "mt-0.5 h-5 w-5 rounded border border-cream-300" %>
          <span>
            <span class="block text-sm font-medium text-heading"><%= t('views.users.personal_access_tokens.new.read_only_label') %></span>
            <span class="<%= hint_class %>"><%= t('views.users.personal_access_tokens.new.read_only_help') %></span>
          </span>
        </label>
      </div>

      <%# What a rename cannot change: fixed when the token was made. %>
      <dl class="space-y-1 rounded-lg border border-cream-300 bg-surface p-4 text-sm">
        <div class="flex flex-wrap gap-x-2">
          <dt class="text-muted"><%= t('views.users.personal_access_tokens.index.col_scope') %>:</dt>
          <dd class="text-body"><%= render 'scope_summary', token: @token %></dd>
        </div>
        <div class="flex flex-wrap gap-x-2">
          <dt class="text-muted"><%= t('views.users.personal_access_tokens.index.col_expires') %>:</dt>
          <dd class="tabular-nums text-body"><%= l(@token.expires_at, format: :short) %></dd>
        </div>
      </dl>

      <div class="flex justify-end gap-3 pt-2">
        <%= render Neo::Buttons::ButtonComponent.new(
              variant: :secondary,
              size: :large,
              url: users_personal_access_tokens_path
            ) do %>
          <%= t('views.users.personal_access_tokens.new.cancel') %>
        <% end %>
        <%= render Neo::Buttons::ButtonComponent.new(variant: :primary, size: :large, tag: :button, type: 'submit') do %>
          <%= t('views.users.personal_access_tokens.edit.submit') %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
