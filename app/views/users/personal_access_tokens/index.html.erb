<%# The API tokens of a person, in the shapes of the rest of the application
    (doc/belegungstabelle_oberflaeche.md): the shared head with the "+" outermost as
    the title action, the tokens as flat rows of one list (a hard shadow says "press
    me", and a row is not pressed), colours from the token layer. Until 2026-11-12
    every token was a white card with a hard shadow. %>
<% new_token = capture do %>
  <%= render Neo::Buttons::IconButtonComponent.new(
        variant: :primary,
        icon: 'plus-lg',
        size: :medium,
        title: t('views.users.personal_access_tokens.index.new_button'),
        url: new_users_personal_access_token_path
      ) %>
<% end %>
<div>
  <%= render 'head', title_action: new_token %>

  <%# The list beside the plain-language explainer, so a confused non-technical user
      immediately sees what this page is for. On lg the explainer sticks while the
      list scrolls; on small screens the list comes first. The list is capped for
      reading (one token per row, its dates on the line below). %>
  <div class="flex flex-col gap-6 lg:flex-row lg:items-start">
    <div class="width-capped--wide min-w-0 flex-1">
      <p class="width-text mb-6 text-sm text-muted">
        <%= t('views.users.personal_access_tokens.index.subtitle') %>
      </p>

      <% if @tokens.empty? %>
        <div class="rounded-lg border border-dashed border-edge bg-surface p-8 text-center">
          <i class="bi bi-key text-3xl text-faint" aria-hidden="true"></i>
          <p class="mt-3 text-sm text-muted">
            <%= t('views.users.personal_access_tokens.index.empty') %>
          </p>
        </div>
      <% else %>
        <ul class="divide-y divide-divider rounded-lg border border-edge bg-surface" data-token-list>
          <% @tokens.each do |token| %>
            <li class="flex flex-wrap items-start justify-between gap-x-4 gap-y-3 px-4 py-3">
              <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-baseline gap-x-3 gap-y-0.5">
                  <h2 class="truncate text-sm font-semibold text-heading"><%= token.name %></h2>
                  <%= render 'status_badge', token: token %>
                </div>
                <div class="mt-0.5 font-mono text-[12px] text-faint"><%= token.token_prefix %>…</div>

                <p class="mt-2 text-sm text-body">
                  <span class="text-muted"><%= t('views.users.personal_access_tokens.index.col_scope') %>:</span>
                  <%= render 'scope_summary', token: token %>
                </p>

                <dl class="mt-1 flex flex-wrap gap-x-4 gap-y-0.5 text-xs text-muted">
                  <div class="flex gap-1">
                    <dt><%= t('views.users.personal_access_tokens.index.col_created') %>:</dt>
                    <dd class="tabular-nums"><%= l(token.created_at, format: :short) %></dd>
                  </div>
                  <div class="flex gap-1">
                    <dt><%= t('views.users.personal_access_tokens.index.col_expires') %>:</dt>
                    <dd class="tabular-nums"><%= l(token.expires_at, format: :short) %></dd>
                  </div>
                  <% if token.last_used_at %>
                    <div class="flex gap-1">
                      <dt><%= t('views.users.personal_access_tokens.index.col_last_used') %>:</dt>
                      <dd><%= time_ago_in_words(token.last_used_at) %></dd>
                    </div>
                  <% end %>
                </dl>
              </div>

              <% if token.active? %>
                <div class="flex shrink-0 items-center gap-2">
                  <%= render Neo::Buttons::ButtonComponent.new(
                        variant: :secondary,
                        size: :small,
                        icon: 'pencil',
                        url: edit_users_personal_access_token_path(token)
                      ) do %>
                    <%= t('views.users.personal_access_tokens.index.edit') %>
                  <% end %>
                  <%= render Neo::Buttons::ButtonComponent.new(
                        variant: :danger,
                        size: :small,
                        icon: 'x-lg',
                        url: users_personal_access_token_path(token),
                        data: {
                          turbo_method: :delete,
                          turbo_confirm: t('views.users.personal_access_tokens.index.revoke_confirm')
                        }
                      ) do %>
                    <%= t('views.users.personal_access_tokens.index.revoke') %>
                  <% end %>
                </div>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% end %>
    </div>

    <div class="lg:sticky lg:top-6 lg:w-96 lg:shrink-0">
      <%= render 'explainer' %>
    </div>
  </div>
</div>
