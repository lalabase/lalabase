<%# A new API token, in the shapes of the rest of the application: the area's head
    with the crumb line, the form capped for reading (.width-capped), three sections
    as quiet headings over their fields (what the token is, what it reaches, what will
    be created), fields in the style of the account forms, one main action. Until
    2026-11-12 the sections were three cards with hard shadows, the last one lime, and
    the submit a hand-built button. %>
<% field_class = 'block w-full rounded border border-cream-300 bg-surface-raised px-3 py-2 text-sm text-body focus:outline-none focus:border-ink focus:ring-1 focus:ring-ink transition-all' %>
<% label_class = 'mb-1 block text-sm font-medium text-cream-700' %>
<% hint_class = 'mt-1 block text-xs text-muted' %>
<% section_title_class = 'text-base font-semibold text-heading' %>
<div>
  <%= render 'head', page: t('views.users.personal_access_tokens.new.title') %>

  <div class="width-capped"
       data-controller="neo-personal-access-token-form"
       data-neo-personal-access-token-form-organisations-value="<%= @user_organisations.to_json(only: %i[id name]) %>">

    <%= form_with model: @token,
                  url: users_personal_access_tokens_path,
                  method: :post,
                  local: true,
                  data: { turbo: false },
                  class: "space-y-8" do |form| %>

      <%# ---- 1: what the token is ---- %>
      <section aria-labelledby="pat-basic-title">
        <h2 id="pat-basic-title" class="<%= section_title_class %>"><%= t('views.users.personal_access_tokens.new.block_basic') %></h2>

        <div class="mt-4 space-y-5">
          <div>
            <%= form.label :name, t('views.users.personal_access_tokens.new.name_label'),
                  class: label_class %>
            <%= form.text_field :name,
                  placeholder: t('views.users.personal_access_tokens.new.name_placeholder'),
                  required: true,
                  class: field_class %>
            <p class="<%= hint_class %>">
              <%= t('views.users.personal_access_tokens.new.name_help') %>
            </p>
          </div>

          <div>
            <label class="flex items-start gap-2 cursor-pointer">
              <%= form.check_box :read_only,
                    class: "mt-0.5 h-5 w-5 rounded border border-cream-300" %>
              <span>
                <span class="block text-sm font-medium text-heading"><%= t('views.users.personal_access_tokens.new.read_only_label') %></span>
                <span class="<%= hint_class %>"><%= t('views.users.personal_access_tokens.new.read_only_help') %></span>
              </span>
            </label>
          </div>

          <div>
            <label class="<%= label_class %>" for="pat_expires_preset">
              <%= t('views.users.personal_access_tokens.new.expiry_label') %>
            </label>
            <select name="personal_access_token[expires_preset]"
                    id="pat_expires_preset"
                    data-action="change->neo-personal-access-token-form#toggleCustomExpiry"
                    data-neo-personal-access-token-form-target="expiryPresetSelect"
                    class="<%= field_class %>">
              <option value="7"><%= t('views.users.personal_access_tokens.new.expiry_7_days') %></option>
              <option value="30" selected><%= t('views.users.personal_access_tokens.new.expiry_30_days') %></option>
              <option value="60"><%= t('views.users.personal_access_tokens.new.expiry_60_days') %></option>
              <option value="90"><%= t('views.users.personal_access_tokens.new.expiry_90_days') %></option>
              <option value="custom"><%= t('views.users.personal_access_tokens.new.expiry_custom') %></option>
            </select>
            <div class="mt-2 hidden" data-neo-personal-access-token-form-target="customExpiryWrapper">
              <input type="date"
                     autocomplete="off"
                     name="personal_access_token[expires_at]"
                     data-neo-personal-access-token-form-target="customExpiryInput"
                     min="<%= Date.tomorrow %>"
                     max="<%= PersonalAccessToken::MAX_LIFETIME.from_now.to_date %>"
                     class="<%= field_class %>">
            </div>
            <p class="<%= hint_class %>">
              <%= t('views.users.personal_access_tokens.new.expiry_help', days: PersonalAccessToken::MAX_LIFETIME.in_days.to_i) %>
            </p>
          </div>
        </div>
      </section>

      <%# ---- 2: what the token reaches ---- %>
      <section aria-labelledby="pat-organisations-title" class="border-t border-divider pt-6">
        <h2 id="pat-organisations-title" class="<%= section_title_class %> mb-4"><%= t('views.users.personal_access_tokens.new.block_organisations') %></h2>

        <% if @user_organisations.empty? %>
          <p class="text-sm text-red-700">
            <%= t('views.users.personal_access_tokens.new.org_no_orgs') %>
          </p>
        <% else %>
          <fieldset class="flex flex-col gap-2 mb-4">
            <legend class="mb-3 text-sm text-body">
              <%= t('views.users.personal_access_tokens.new.org_pick_label') %>
            </legend>
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="radio"
                     name="personal_access_token[organisation_mode]"
                     value="selected"
                     <%= 'checked' unless @organisation_mode == 'all' %>
                     data-action="change->neo-personal-access-token-form#toggleOrganisationMode"
                     data-neo-personal-access-token-form-target="organisationMode"
                     class="border border-cream-300">
              <span class="text-sm font-medium text-heading"><%= t('views.users.personal_access_tokens.new.org_mode_selected') %></span>
            </label>
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="radio"
                     name="personal_access_token[organisation_mode]"
                     value="all"
                     <%= 'checked' if @organisation_mode == 'all' %>
                     aria-describedby="pat-org-mode-all-hint"
                     data-action="change->neo-personal-access-token-form#toggleOrganisationMode"
                     data-neo-personal-access-token-form-target="organisationMode"
                     class="border border-cream-300">
              <span class="text-sm font-medium text-heading"><%= t('views.users.personal_access_tokens.new.org_mode_all') %></span>
            </label>
            <p id="pat-org-mode-all-hint" class="ml-6 text-xs text-muted">
              <%= t('views.users.personal_access_tokens.new.org_mode_all_hint') %>
            </p>
          </fieldset>

          <div class="space-y-3 <%= 'hidden' if @organisation_mode == 'all' %>" data-neo-personal-access-token-form-target="organisationList">
            <% @user_organisations.each do |org| %>
              <div class="rounded border border-cream-300 bg-surface-raised p-3"
                   data-neo-personal-access-token-form-target="orgBlock"
                   data-org-id="<%= org.id %>">
                <label class="flex items-center gap-2 cursor-pointer">
                  <input type="checkbox"
                         name="personal_access_token[organisation_ids][]"
                         value="<%= org.id %>"
                         data-action="change->neo-personal-access-token-form#toggleOrg"
                         data-neo-personal-access-token-form-target="orgCheckbox"
                         class="h-5 w-5 rounded border border-cream-300">
                  <span class="text-sm font-medium text-heading"><%= org.name %></span>
                </label>

                <div class="hidden ml-7 mt-3 space-y-2"
                     data-neo-personal-access-token-form-target="projectScopeWrapper">
                  <div class="flex flex-col gap-1">
                    <label class="flex items-center gap-2 text-sm text-body">
                      <input type="radio"
                             name="personal_access_token[project_mode][<%= org.id %>]"
                             value="all"
                             checked
                             data-action="change->neo-personal-access-token-form#toggleProjectMode"
                             class="border border-cream-300">
                      <%= t('views.users.personal_access_tokens.new.project_all') %>
                    </label>
                    <label class="flex items-center gap-2 text-sm text-body">
                      <input type="radio"
                             name="personal_access_token[project_mode][<%= org.id %>]"
                             value="selected"
                             data-action="change->neo-personal-access-token-form#toggleProjectMode"
                             class="border border-cream-300">
                      <%= t('views.users.personal_access_tokens.new.project_selected') %>
                    </label>
                  </div>

                  <div class="hidden mt-2 pl-6 space-y-1"
                       data-neo-personal-access-token-form-target="projectList">
                    <% (@projects_by_organisation[org] || []).each do |project| %>
                      <label class="flex items-center gap-2 text-sm text-body">
                        <input type="checkbox"
                               name="personal_access_token[project_ids][<%= org.id %>][]"
                               value="<%= project.id %>"
                               class="h-4 w-4 rounded border border-cream-300">
                        <%= project.name %>
                      </label>
                    <% end %>
                    <% if (@projects_by_organisation[org] || []).empty? %>
                      <p class="text-xs italic text-muted">
                        <%= t('views.users.personal_access_tokens.new.project_no_projects') %>
                      </p>
                    <% end %>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>
      </section>

      <%# ---- 3: what will be created, and the password that confirms it ---- %>
      <section aria-labelledby="pat-summary-title" class="border-t border-divider pt-6">
        <h2 id="pat-summary-title" class="<%= section_title_class %>"><%= t('views.users.personal_access_tokens.new.block_summary') %></h2>

        <%# A flat status box (F30): it repeats the choices above in one place, live
            (neo-personal-access-token-form), before the password is asked for. %>
        <div class="mt-4 rounded-lg border border-cream-300 bg-surface p-4">
          <p class="text-sm text-muted">
            <%= t('views.users.personal_access_tokens.new.summary_intro') %>
          </p>
          <ul class="mt-2 list-inside list-disc space-y-1 text-sm font-medium text-body"
              data-neo-personal-access-token-form-target="summaryList">
            <li class="italic text-faint"
                data-neo-personal-access-token-form-target="summaryPlaceholder">
              <%= t('views.users.personal_access_tokens.new.summary_pick_org') %>
            </li>
          </ul>

          <p class="mt-3 text-sm text-body"
             data-neo-personal-access-token-form-target="summaryExpiry">
            <%= t('views.users.personal_access_tokens.new.summary_valid_until', date: l(30.days.from_now.to_date, format: :short)) %>
          </p>
        </div>

        <div class="mt-5">
          <label class="<%= label_class %>" for="pat_current_password">
            <%= t('views.users.personal_access_tokens.new.password_label') %>
          </label>
          <%= password_field_tag :current_password, nil,
                id: 'pat_current_password',
                required: true,
                autocomplete: 'current-password',
                class: field_class %>
          <p class="<%= hint_class %>">
            <%= t('views.users.personal_access_tokens.new.password_help') %>
          </p>
        </div>

        <div class="mt-6 flex justify-end gap-3">
          <%= render Neo::Buttons::ButtonComponent.new(
                variant: :secondary,
                size: :large,
                url: users_personal_access_tokens_path
              ) do %>
            <%= t('views.users.personal_access_tokens.new.cancel') %>
          <% end %>
          <%= render Neo::Buttons::ButtonComponent.new(variant: :primary, size: :large, tag: :button, type: 'submit') do %>
            <%= t('views.users.personal_access_tokens.new.submit') %>
          <% end %>
        </div>
      </section>
    <% end %>
  </div>
</div>
