# frozen_string_literal: true

namespace :importmap do
  desc 'Scan app/javascript/controllers and write pins into config/importmap.rb'
  task auto_pin: :environment do
    root       = Rails.root
    js_root    = root.join('app/javascript')
    map_path   = root.join('config/importmap.rb')

    controller_files =
      Dir.glob(js_root.join('controllers/**/*_controller.js')) +
      Dir.glob(js_root.join('controllers/index.js'))

    pins = controller_files.map do |abs|
      rel = Pathname(abs).relative_path_from(js_root).to_s # e.g. "controllers/foo_controller.js"
      mod = rel.sub(/\.js\z/, '') # e.g. "controllers/foo_controller"
      "  pin '#{mod}', to: '#{rel}'"
    end.sort

    # Don't include controllers/index in auto pins since it's manually pinned
    pins.reject! { |pin| pin.include?("'controllers/index'") }

    block = <<~RUBY.chomp
        # BEGIN AUTO PINS (generated by rake importmap:auto_pin)
      #{pins.join("\n")}
        # END AUTO PINS
    RUBY

    content = File.read(map_path)

    # Make sure there is a production block
    abort 'config/importmap.rb requires a development?/else block.' unless content.include?('if Rails.env.development?')

    # Replace the marked region inside the else branch
    new_content = content.gsub(
      /(else\s*\n)(.*?)(\nend)/m
    ) do |_match|
      head = Regexp.last_match(1)
      middle = Regexp.last_match(2)
      tail = Regexp.last_match(3)
      # ^[ \t]* also consumes the existing indentation of the BEGIN line, otherwise
      # the old whitespace stays in place and the block prepends its own 2 spaces
      # → not idempotent (indent grows on every run, CI diff always fails).
      auto_rx = /^[ \t]*# BEGIN AUTO PINS .*?# END AUTO PINS/m
      replaced =
        if middle.match?(auto_rx)
          middle.gsub(auto_rx, block)
        else
          # Append the block at the end of the else branch
          middle.rstrip + "\n\n" + block + "\n"
        end
      head + replaced + tail
    end

    # Ensure mandatory controller pins are always present
    mandatory_pins = [
      "  pin 'controllers/index', to: 'controllers/index.js'",
      "  pin 'controllers', to: 'controllers/index.js'"
    ]

    mandatory_pins.each do |mandatory_line|
      next if new_content.include?(mandatory_line)

      new_content = new_content.gsub(
        /(else\s*\n)(.*?)(\n.*?# BEGIN AUTO PINS)/m
      ) do |_match|
        head = Regexp.last_match(1)
        middle = Regexp.last_match(2)
        auto_pins_start = Regexp.last_match(3)
        head + middle.rstrip + "\n" + mandatory_line + "\n" + auto_pins_start
      end
    end

    File.write(map_path, new_content)
    puts "Wrote #{controller_files.size} pins into #{map_path}"
  end

  desc 'Check that all controllers are pinned in Production block'
  task verify: :environment do
    root     = Rails.root
    js_root  = root.join('app/javascript')
    map_path = root.join('config/importmap.rb')

    controllers = Dir.glob(js_root.join('controllers/**/*_controller.js')).map do |abs|
      Pathname(abs).relative_path_from(js_root).to_s.sub(/\.js\z/, '')
    end

    # NOTE: controllers/index is handled by the manual 'controllers' alias pin

    prod_section = File.read(map_path)[/else\s*\n(.*?)\nend/m, 1] || ''

    # Check that controllers module is available (either direct pin or alias)
    has_controllers_access = prod_section.include?("pin 'controllers/index'") ||
                             prod_section.include?("pin 'controllers', to: 'controllers/index.js'")

    unless has_controllers_access
      puts "Missing controllers module access (need either 'controllers/index' pin or 'controllers' alias)"
      exit 1
    end

    missing = controllers.reject { |m| prod_section.include?("pin '#{m}'") }

    if missing.empty?
      puts 'All controllers pinned ✔'
    else
      puts "Missing pins:\n" + missing.map { |m| "  pin '#{m}', to: '#{m}.js'" }.join("\n")
      exit 1
    end
  end
end
