# Copy to /etc/lalabase-backup/alert.conf on BOTH hosts and adjust PEER_*.
# Values only — this file is sourced by shell scripts. No secrets here; the SMTP
# password lives in /etc/lalabase-backup/msmtprc (mode 600).

ALERT_TO="empfaenger@example.com"
ALERT_FROM="ops@example.com"

# App server points at the DB host and vice versa (private network).
PEER_HOST="root@<private address of the other host>"
PEER_LABEL="DB-Host (Datenbank-Sicherung)"
OWN_LABEL="App-Server (Anhang-Sicherung)"

# 26 rather than 24: a run shifting by an hour is normal, and an alarm that cries
# wolf gets ignored within two weeks.
MAX_AGE_HOURS=26
